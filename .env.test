# .env.test
# Configurazione dell'ambiente di test: versionata, ha la precedenza su .env.example.
# .env.local viene ignorato quando APP_ENV=test.

### ambiente di test
APP_ENV='test'

### parametri di connessione al database
DATABASE_URL='mysql://root:root@localhost:3306/giuaschool'

### codice segreto usato solo dall'ambiente di test, dove i dati sono di prova
APP_SECRET='codice-segreto-ambiente-di-test'

### necessario per l'ambiente di test
KERNEL_CLASS='App\Kernel'

### evita messaggi di warning
SYMFONY_DEPRECATIONS_HELPER=999999

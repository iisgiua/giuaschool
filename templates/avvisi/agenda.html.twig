{% extends 'base.html.twig' %}

{% block pagina_menu %}
  {% if is_granted('ROLE_DOCENTE') %}
    {{ include('ruolo_docente/menu.html.twig') }}
  {% elseif is_granted('ROLE_ATA') %}
    {{ include('ruolo_ata/menu.html.twig') }}
  {% elseif is_granted('ROLE_GENITORE') %}
    {{ include('ruolo_genitore/menu_genitore.html.twig') }}
  {% elseif is_granted('ROLE_ALUNNO') %}
    {{ include('ruolo_genitore/menu_alunno.html.twig') }}
  {% endif %}
{% endblock %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-0 gs-mb-2">{{ (info.visualizzazione == 'P' ? 'title.agenda_eventi' : 'title.agenda_verifiche')|trans }}</h1>
  <div class="gs-page-toolbar">
    <div class="gs-date-nav" role="group" aria-label="Cambia mese">
      {% if info.url_prec %}
      <a class="btn btn-default gs-date-nav-btn" href="{{ path('avvisi_agenda', {mese: info.url_prec, visualizzazione: info.visualizzazione, classe: info.classeId}) }}" role="button" title="Mese precedente" aria-label="Mese precedente">{{ include('admin/include/icona.html.twig', {nome: 'chevron-left', stile: 'outline'}) }}</a>
      {% endif %}
      <span class="gs-date-btn" aria-live="polite">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>{{ info.nome_mese }}</strong></span>
      {% if info.url_succ %}
      <a class="btn btn-default gs-date-nav-btn" href="{{ path('avvisi_agenda', {mese: info.url_succ, visualizzazione: info.visualizzazione, classe: info.classeId}) }}" role="button" title="Mese successivo" aria-label="Mese successivo">{{ include('admin/include/icona.html.twig', {nome: 'chevron-right', stile: 'outline'}) }}</a>
      {% endif %}
    </div>
    <div class="gs-toolbar-spacer" aria-hidden="true"></div>
    {# Visualizzazione e inserimenti: solo i docenti hanno dati.filtro e
       dati.azioni popolati dal controller. #}
    {% if app.user.controllaRuolo('D') %}
    <div class="gs-toolbar-controls">
      <div class="gs-toolbar-filter">
        <span class="gs-toolbar-label">Visualizzazione</span>
        <div class="dropdown">
          <button class="btn gs-dropdown-testo dropdown-toggle" id="gs-dropdown-menu" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Clicca per cambiare il tipo di visualizzazione"><strong id="gs-visualizza-tipo">{{ info.visualizzazione == 'P' ? 'Normale' : 'Verifiche ' ~ info.classe }}</strong><span class="caret gs-ml-2"></span></button>
          <ul class="dropdown-menu" aria-labelledby="gs-dropdown-menu">
            <li{{ info.visualizzazione == 'P' ? ' class="active"' }}><a href="{{ path('avvisi_agenda', {mese: info.url_mese}) }}">Normale</a></li>
    {% for c, n in dati.filtro %}
            <li{{ info.classeId == c ? ' class="active"' }}><a href="{{ path('avvisi_agenda', {mese: info.url_mese, visualizzazione: 'V', classe: c}) }}">Verifiche {{ n }}</a></li>
    {% endfor %}
          </ul>
        </div>
      </div>
      {% if dati.azioni.add is defined %}
      <div class="gs-toolbar-action">
        <a class="btn btn-primary" href="{{ path('avvisi_edit_agenda', {tipo: 'V'}) }}" role="button" title="Aggiungi una nuova verifica">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Aggiungi verifica</strong></a>
        <a class="btn btn-default" href="{{ path('avvisi_edit_agenda', {tipo: 'P'}) }}" role="button" title="Aggiungi nuovi compiti per casa">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Aggiungi compiti</strong></a>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% set intestazione = [
      {contenuto: 'label.lunedi'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.martedi'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.mercoledi'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.giovedi'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.venerdi'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.sabato'|trans, classi: 'text-center col-sm-2', scope: 'col'},
      {contenuto: 'label.domenica'|trans, classi: 'text-center col-sm-2', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
      <tr>
  {% for i in (1 - info.inizio)..info.ultimo_giorno %}
{# la griglia e' di 7 colonne (lunedi..domenica): la riga si chiude PRIMA di
    stampare l'ottava cella. Prima il salto era dentro l'if che decideva il
    contenuto della cella, quindi consumava la cella stessa e le domeniche del
    mese non venivano disegnate. #}
    {% if loop.index > 1 and (loop.index - 1) % 7 == 0 %}
    </tr>
    <tr>
    {% endif %}
    {% if i < 1 %}
      <td class="gs-calendar-empty">&nbsp;</td>
    {% else %}
      {% if dati.festivi[i] is defined %}
      <td class="gs-calendar-holiday">
        <strong class="gs-calendar-day-number">{{ i }}</strong>
      </td>
      {% else %}
      <td class="{{ dati[i] is defined ? 'gs-calendar-has-events' : '' }}">
        <strong class="gs-calendar-day-number">{{ i }}</strong>
        {% if info.visualizzazione == 'P' and dati[i] is defined %}
        <div class="gs-calendar-events">
          {% if dati[i].Q is defined %}
          <button class="gs-calendar-event gs-calendar-event-primary gs-button-remote" type="button" title="Visualizza i colloqui previsti in questa data" data-toggle="modal" data-target="#gs-modal-remote" data-href="{{ path('avvisi_dettagli_agenda', {data: info.url_mese ~ '-' ~ ('%02d'|format(i)), tipo: 'Q'}) }}">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Colloqui</strong></button>
          {% endif %}
          {% if dati[i].V is defined %}
          <button class="gs-calendar-event gs-calendar-event-primary gs-button-remote" type="button" title="Visualizza le verifiche previste in questa data" data-toggle="modal" data-target="#gs-modal-remote" data-href="{{ path('avvisi_dettagli_agenda', {data: info.url_mese ~ '-' ~ ('%02d'|format(i)), tipo: 'V'}) }}">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Verifiche</strong></button>
          {% endif %}
          {% if dati[i].A is defined %}
          <button class="gs-calendar-event gs-calendar-event-primary gs-button-remote" type="button" title="Visualizza le attività previste in questa data" data-toggle="modal" data-target="#gs-modal-remote" data-href="{{ path('avvisi_dettagli_agenda', {data: info.url_mese ~ '-' ~ ('%02d'|format(i)), tipo: 'A'}) }}">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Attività</strong></button>
          {% endif %}
          {% if dati[i].P is defined %}
          <button class="gs-calendar-event gs-button-remote" type="button" title="Visualizza i compiti per casa assegnati per questa data" data-toggle="modal" data-target="#gs-modal-remote" data-href="{{ path('avvisi_dettagli_agenda', {data: info.url_mese ~ '-' ~ ('%02d'|format(i)), tipo: 'P'}) }}">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Compiti</strong></button>
          {% endif %}
        </div>
        {% elseif dati[i] is defined %}
        <div class="gs-calendar-events">
          <button class="gs-calendar-event gs-calendar-event-primary gs-button-remote" type="button" title="Visualizza le verifiche previste in questa data per la classe indicata" data-toggle="modal" data-target="#gs-modal-remote" data-href="{{ path('avvisi_dettagli_agenda', {data: info.url_mese ~ '-' ~ ('%02d'|format(i)), tipo: 'S', classe: info.classeId}) }}">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Verifiche: {{ dati[i] }}</strong></button>
        </div>
        {% endif %}
      </td>
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if info.fine > 0 %}
    {% for i in 1..info.fine %}
        <td class="gs-calendar-empty">&nbsp;</td>
    {% endfor %}
  {% endif %}
      </tr>
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, intestazione: [intestazione], classi: 'gs-calendar gs-mb-5'}) }}
  {{ include('include/modal-remote.html.twig') }}
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.cancella_verifica'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href');
    $(this).find('#gs-modal-remote-content').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
  });
});
</script>
{% endblock %}

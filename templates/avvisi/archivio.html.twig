{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-avvisi-archivio">
  <h1 class="text-center gs-h2 gs-mt-2">{{ 'title.staff_avvisi_archivio'|trans }}</h1>
  <form name="{{ form.vars.name }}" method="{{ form.vars.method }}" action="{{ form.vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form.vars.id }}">
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col" title="{{ form.anno.vars.label|trans }}">
          <label class="control-label" for="avviso_filtro_anno">{{ form.anno.vars.label|trans }}</label>
          {{ form_widget(form.anno) }}
        </div>
        <div class="form-group gs-filter-col" title="{{ form.autore.vars.label|trans }}">
          <label class="control-label" for="avviso_filtro_autore">{{ form.autore.vars.label|trans }}</label>
          {{ form_widget(form.autore) }}
        </div>
        <div class="form-group gs-filter-col" title="{{ form.tipo.vars.label|trans }}">
          <label class="control-label" for="avviso_filtro_tipo">{{ form.tipo.vars.label|trans }}</label>
          {{ form_widget(form.tipo) }}
        </div>
        <div class="form-group gs-filter-col" title="{{ form.mese.vars.label|trans }}">
          <label class="control-label" for="avviso_filtro_mese">{{ form.mese.vars.label|trans }}</label>
          {{ form_widget(form.mese) }}
        </div>
      </div>
      <div class="gs-filters-buttons">
        <button type="button" class="btn btn-default" id="avviso_archivio_reset" title="Resetta i filtri">Reset</button>
        {{ form_widget(form.submit) }}
      </div>
      {{ form_widget(form._token) }}
    </div>
  </form>
  <div class="row gs-mb-1">
    <div class="col-sm-6">
    </div>
    <div class="col-sm-6 text-right">
    </div>
  </div>
  {% if dati.lista|length > 0 %}
  {% set intestazione = [
    {contenuto: 'label.autore'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.tipo'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.data'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.oggetto'|trans, classi: 'col-sm-5', scope: 'col'},
    {contenuto: 'label.destinatari'|trans, classi: 'col-sm-3', scope: 'col'},
    {contenuto: 'label.action'|trans, classi: 'col-sm-1', scope: 'col'}
  ] %}
  {% set righe = [] %}
  {% for k, a in dati.lista %}
    {% set destinatari %}
          <small>{% set inizio = 1 %}
    {% if 'D' in a.speciali %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}DSGA{% endif -%}
    {% if 'S' in a.speciali %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RSPP{% endif -%}
    {% if 'R' in a.speciali %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RSU{% endif -%}
    {% if 'I' in a.speciali %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RAPPRESENTANTI DI ISTITUTO{% endif -%}
    {% if 'P' in a.speciali %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RAPPRESENTANTI CONSULTA PROVICIALE{% endif -%}
    {% if 'A' in a.ata and 'T' in a.ata and 'C' in a.ata %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}ATA
    {%- elseif 'A' in a.ata or 'T' in a.ata or 'C' in a.ata %}
      {%- if 'A' in a.ata %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}AMMINISTRATIVI{% endif -%}
      {%- if 'T' in a.ata %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}TECNICI{% endif -%}
      {%- if 'C' in a.ata %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}COLL.SCOLAST.{% endif -%}
    {% endif -%}
    {% if a.coordinatori != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}COORDINATORI{% endif -%}
    {% if a.docenti != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}DOCENTI{% endif -%}
    {% if a.genitori != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}GENITORI{% endif -%}
    {% if a.alunni != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}ALUNNI{% endif -%}
    {% if a.rappresentantiGenitori != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RAPPRESENTANTI GENITORI{% endif -%}
    {% if a.rappresentantiAlunni != 'N' %}{% if inizio %}{% set inizio = 0 %}{% else %}, {% endif %}RAPPRESENTANTI ALUNNI{% endif -%}
          </small>
    {% endset %}
    {% set pulsante %}
          {{ include('include/bottone-azione.html.twig', {
            nome: 'eye', etichetta: 'Visualizza', titolo: 'Visualizza i dettagli dell\'avviso',
            classi: 'gs-button-remote',
            attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote',
                        'data-href': path('avvisi_dettagli_gestione', {avviso: a.id})}
          }) }}
    {% endset %}
    {% set righe = righe|merge([{celle: [
      {contenuto: '<small>' ~ a.autore.nome ~ ' ' ~ a.autore.cognome ~ '</small>'},
      {contenuto: '<small>' ~ ('label.avvisi_tipo_' ~ a.tipo)|trans ~ '</small>'},
      {contenuto: a.data|date('d/m/Y')},
      {contenuto: a.titolo},
      {contenuto: destinatari},
      {contenuto: [pulsante]}
    ]}]) %}
  {% endfor %}
  {{ include('include/tabella.html.twig', {intestazione: [intestazione], corpo: righe}) }}
  {{ include('include/paginate.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'avvisi_archivio'}) }}
  {% else %}
  <div class="alert alert-info" role="alert">
    <strong class="gs-big">Nessun avviso presente</strong>
  </div>
  {% endif %}
  {{ include('include/modal-remote.html.twig') }}
  {{ include('include/modal-waiting.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href');
    $(this).find('#gs-modal-remote-content').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
  $('#avviso_filtro_anno').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#avviso_filtro_autore').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#avviso_filtro_tipo').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#avviso_filtro_mese').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#avviso_archivio_reset').click(function (e) {
    e.preventDefault();
    $('#avviso_filtro_anno').val('');
    $('#avviso_filtro_autore').val('');
    $('#avviso_filtro_tipo').val('');
    $('#avviso_filtro_mese').val('');
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
});
</script>
{% endblock %}

{% extends 'lezioni/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not cattedra and not classe %}
  <h1 class="text-center gs-h1 gs-mt-2">{{ 'title.lezioni_assenze'|trans }}</h1>
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.cattedra_mancante'|trans }}</strong>
  </div>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context = false) }}
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-0">{{ 'title.lezioni_assenze'|trans }} {{ classe }}</h1>
  <h2 class="text-center gs-h2 gs-mt-0 gs-mb-5"><em>{{ info.materia }}{% if info.alunno %}<button type="button" class="btn btn-xs btn-default gs-ml-3" title="Informazioni sulla cattedra" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ info.alunno }}">{{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}</button>{% endif %}</em></h2>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context = false) }}
    {% if errore %}
  <div class="row gs-mb-5">
    <div class="col-sm-12">
      {% if data_prec %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data_prec|date('Y-m-d'), vista: 'G'}) }}" role="button" title="Giorno precedente">{{ include('admin/include/icona.html.twig', {nome: 'chevron-left', stile: 'outline'}) }}</a>{% endif %}
      <button class="btn btn-primary gs-pt-2 gs-pb-2" id="gs-button-date" title="Cambia giorno">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline', classe: 'gs-mr-3'}) }}<strong>{{ info.data_label }}</strong></button>
      {% if data_succ %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data_succ|date('Y-m-d'), vista: 'G'}) }}" role="button" title="Giorno successivo">{{ include('admin/include/icona.html.twig', {nome: 'chevron-right', stile: 'outline'}) }}</a>{% endif %}
    </div>
  </div>
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ errore }}</strong>
  </div>
    {% else %}
  <div class="row gs-mb-1">
    <div class="col-sm-5">
      {% if data_prec %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data_prec|date('Y-m-d'), vista: 'G'}) }}" role="button" title="Giorno precedente">{{ include('admin/include/icona.html.twig', {nome: 'chevron-left', stile: 'outline'}) }}</a>{% endif %}
      <button class="btn btn-primary gs-pt-2 gs-pb-2" id="gs-button-date" title="Cambia giorno">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline', classe: 'gs-mr-3'}) }}<strong>{{ info.data_label }}</strong></button>
      {% if data_succ %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data_succ|date('Y-m-d'), vista: 'G'}) }}" role="button" title="Giorno successivo">{{ include('admin/include/icona.html.twig', {nome: 'chevron-right', stile: 'outline'}) }}</a>{% endif %}
    </div>
    <div class="col-sm-2 text-center">
      {% if dati[data].pulsante_appello is defined %}
      <a class="btn btn-success" href="{{ dati[data].pulsante_appello }}" role="button" title="Esegui la procedura dell'appello">{{ include('admin/include/icona.html.twig', {nome: 'hand-stop', stile: 'outline', classe: 'gs-mr-3'}) }}Appello</a>
      {% endif %}
    </div>
    <div class="col-sm-3 text-right">
      {% if not cattedra %}
      <strong class="gs-big gs-mr-2">Filtro:</strong>
      <select id="gs-filtro-alunni" class="gs-placeholder form-control" style="width:auto;display:inline;">
        <option value="T">Tutti</option>
        <option value="S">Gruppo: Religione</option>
        <option value="A">Gruppo: Mat. Alt.</option>
        <option value="N">Gruppo: N. A.</option>
      </select>
      {% endif %}
    </div>
    <div class="col-sm-2 text-right">
      <strong class="gs-big">Vista:</strong>
      <a class="btn btn-default btn-sm active" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data, vista: 'G'}) }}" role="button" title="Visualizza le assenze del giorno">{{ include('admin/include/icona.html.twig', {nome: 'player-stop', stile: 'outline'}) }}</a>
      <a class="btn btn-default btn-sm" href="{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: data, vista: 'M'}) }}" role="button" title="Visualizza le assenze del mese">{{ include('admin/include/icona.html.twig', {nome: 'layout-grid', stile: 'outline'}) }}</a>
    </div>
  </div>
      {% set tipo_rel = (cattedra and cattedra.materia.tipo == 'R' and cattedra.tipo == 'A') ? 'A' : (cattedra and cattedra.materia.tipo == 'R' ? 'S' : '') %}
      {% for tab in ['N', 'R'] %}
        {% if tab == 'N' or (cattedra and cattedra.materia.tipo == 'R') %}
  {% set intestazione = [
      {contenuto: '#', scope: 'col'},
      {contenuto: 'Alunno', scope: 'col'},
      {contenuto: 'Situazione', scope: 'col'},
      {contenuto: 'Giustificazioni', scope: 'col'},
      {contenuto: 'Azioni', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
          {% for k, v in dati[data].lista %}
            {% if (tab == 'N' and (not cattedra or cattedra.materia.tipo != 'R' or v.religione == tipo_rel)) or (tab == 'R' and v.religione != tipo_rel) %}
      <tr id="gs-alunno-{{ v.id_alunno }}" class="gs-alunno-riga">
        <td>{{ loop.index }}</td>
        <td>
          {{ include('include/bottone-azione.html.twig', {nome: 'eye', etichetta: 'Dettagli alunno', titolo: 'Dettagli alunno', stile: 'default', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-info', 'data-title': v.cognome ~ ' ' ~ v.nome ~ ' (' ~ v.dataNascita|date('d/m/Y') ~ ')', 'data-body': 'alunno-' ~ loop.index}}) }}
          <strong>{{ v.cognome }} {{ v.nome }} ({{ v.dataNascita|date('d/m/Y') }})</strong>
              {% if v.autorizzaEntrata is not empty %}
          <button type="button" class="btn btn-xs btn-info gs-ml-1" title="Autorizzazione all'entrata in ritardo" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ v.autorizzaEntrata }}">{{ include('admin/include/icona.html.twig', {nome: 'clock', stile: 'outline'}) }}</button>
              {% endif %}
              {% if v.autorizzaUscita is not empty %}
          <button type="button" class="btn btn-xs btn-warning gs-ml-1" title="Autorizzazione all'uscita anticipata" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ v.autorizzaUscita }}">{{ include('admin/include/icona.html.twig', {nome: 'clock', stile: 'outline'}) }}</button>
              {% endif %}
          {{ include('include/scheda-alunno.html.twig', {id: loop.index, a: v, g: dati[data].genitori[v.id_alunno]}) }}
              {% if dati.cambio[v.id_alunno] is defined %}
          <br><strong class="text-danger">{{ dati.cambio[v.id_alunno] }}</strong>
              {% endif %}
        </td>
        <td>
              {% if v.id_assenza %}
          <span class="label label-danger">Assente</span>
              {% endif %}
              {% if v.id_entrata %}
          <span class="label label-warning gs-mr-1"{% if v.note_entrata %} title="Note sul ritardo" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ v.note_entrata }}"{% endif %}>Ritardo ({{ v.ora_entrata|date('H:i') }})
                {% if v.note_entrata %} {{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}{% endif %}
          </span>
              {% endif %}
              {% if v.id_uscita %}
          <span class="label label-warning"{% if v.note_uscita %} title="Note sull'uscita anticipata" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ v.note_uscita }}"{% endif %}>Uscita ({{ v.ora_uscita|date('H:i') }})
                {% if v.note_uscita %} {{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}{% endif %}
          </span>
              {% endif %}
              {% if v.id_presenza %}
          <span class="label label-success gs-mr-1" title="Fuori classe {% if v.oraInizio %}dalle {{ v.oraInizio|date('H:i') }}{% if v.oraFine %} alle {{ v.oraFine|date('H:i') }}{% endif %}{% else %}tutto il giorno{% endif %}" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ ('label.presenza_tipo_' ~ v.tipo)|trans }}: {{ v.descrizione }}">Fuori classe
            {{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}
          </span>
              {% endif %}
              {% if v.uscite > 0 %}
          <span class="label label-info pull-right gs-ml-1 gs-mt-1">Uscite: {{ v.uscite }}</span>
              {% endif %}
              {% if v.ritardi > 0 %}
          <span class="label label-info pull-right gs-mt-1">Ritardi: {{ v.ritardi }}</span>
              {% endif %}
        </td>
        <td>
              {% if v.convalide > 0 %}
          <span class="label label-success gs-mr-3">{{ v.convalide }} convalid{{ v.convalide > 1 ? 'e' : 'a' }}</span>
              {% endif %}
              {% if v.giustifica_assenze > 0 %}
          <span class="badge gs-mr-3">{{ v.giustifica_assenze }} assenz{{ v.giustifica_assenze > 1 ? 'e' : 'a' }}</span>
              {% endif %}
              {% if v.giustifica_ritardi > 0 %}
          <span class="badge gs-mr-3">{{ v.giustifica_ritardi }} ritard{{ v.giustifica_ritardi > 1 ? 'i' : 'o' }}</span>
              {% endif %}
              {% if v.giustifica_uscite > 0 %}
          <span class="badge gs-mr-3">{{ v.giustifica_uscite }} uscit{{ v.giustifica_uscite > 1 ? 'e' : 'a' }}</span>
              {% endif %}
        </td>
        <td>
          {% set voci_presenze = [] %}
              {% if v.pulsante_presenza is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Presenza', titolo: 'Segna la presenza dell\'alunno', attributi: {'data-href': v.pulsante_presenza}, classi: 'gs-button-remote text-success', disabilitata: v.pulsante_presenza == '#'}]) %}
              {% endif %}
              {% if v.pulsante_assenza is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Assenza', titolo: 'Segna l\'assenza dell\'alunno', attributi: {'data-href': v.pulsante_assenza}, classi: 'gs-button-remote text-danger', disabilitata: v.pulsante_assenza == '#'}]) %}
              {% endif %}
              {% if v.pulsante_entrata is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Ritardo', titolo: 'Segna il ritardo dell\'alunno', attributi: {'data-href': v.pulsante_entrata}, classi: 'gs-button-remote text-warning', disabilitata: v.pulsante_entrata == '#'}]) %}
              {% endif %}
              {% if v.pulsante_uscita is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Uscita anticipata', titolo: 'Segna l\'uscita anticipata dell\'alunno', attributi: {'data-href': v.pulsante_uscita}, classi: 'gs-button-remote text-warning', disabilitata: v.pulsante_uscita == '#'}]) %}
              {% endif %}
              {% if v.pulsante_fc is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Fuori classe', titolo: 'Imposta o elimina il fuori classe dell\'alunno', attributi: {'data-href': v.pulsante_fc}, classi: 'gs-button-remote', disabilitata: v.pulsante_fc == '#'}]) %}
              {% endif %}
              {% if v.pulsante_giustifica is defined %}
            {% set voci_presenze = voci_presenze|merge([{etichetta: 'Giustifica', titolo: 'Giustifica le assenze e i ritardi', attributi: {'data-href': v.pulsante_giustifica}, classi: 'gs-button-remote text-primary'}]) %}
              {% endif %}
          {{ include('include/menu-azioni.html.twig', {voci: voci_presenze, titolo: 'Registra evento'}) }}
        </td>
      </tr>
            {% endif %}
          {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
        {% endif %}
      {% endfor %}
      {{ include('include/modal-info.html.twig') }}
    {% endif %}
  {% endif %}
</div>
{% endblock %}

{% block pagina_css %}
{{ parent() }}
<link href="{{ asset('vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet">
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js') }}"></script>
<script src="{{ asset('vendor/bootstrap-datepicker/locales/bootstrap-datepicker.it.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('#gs-button-date').datepicker({
    format: "yyyy-mm-dd",
    weekStart: 1,
    maxViewMode: 1,
    daysOfWeekDisabled: "0",
    defaultViewDate: "{{ data }}",
    startDate: "{{ app.session.get('/CONFIG/SCUOLA/anno_inizio') }}",
    endDate: "{{ app.session.get('/CONFIG/SCUOLA/anno_fine') }}",
    {% if lista_festivi %}datesDisabled: {{ lista_festivi|raw }},{% endif %}
    todayBtn: "linked",
    todayHighlight: true,
    autoclose: true,
    language: "it",
    zIndexOffset: 1200
    });
  $('#gs-button-date').datepicker()
    .on('show', function(ev){
      $('#gs-button-date').datepicker('update', '{{ data }}');
  });
  $('#gs-button-date').datepicker()
    .on('changeDate', function(ev){
      $('#gs-button-date').datepicker('hide');
      url = "{{ path('lezioni_assenze_quadro', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: '9999-99-99', vista: 'G'}) }}";
      url = url.replace("9999-99-99", ev.format());
      window.location.href = url;
  });
  $('[data-toggle="popover"]').popover();
  $('#gs-modal-info').on('show.bs.modal', function (event) {
    var title = $(event.relatedTarget).data('title');
    var id = $(event.relatedTarget).data('body');
    var html = $('#'+id).html();
    $(this).find('#gs-modal-info-label').text(title);
    $(this).find('#gs-modal-info-body').html(html);
  });
  $('#gs-modal-info').on('shown.bs.modal', function (e) {
    $('body').addClass('modal-open');
    $('button.gs-show-hide').on('click', function (e) {
      var el = $(this).parent().siblings('div');
      if (el.is(':visible')) {
        el.fadeOut();
        $(this).attr('title', 'Apre la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize');
      } else {
        el.fadeIn();
        $(this).attr('title', 'Chiude la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize');
      }
    });
  });
  $('.gs-button-remote').click(function(e) {
    var url = $(e.target).data('href');
    if (url != '#') {
      window.location.href = url+'/'+Math.floor($('html').scrollTop());
    }
  });
  /* Filtro per gruppo (esiste solo in sostituzione): la scelta persiste in
     sessionStorage con chiave per classe, cosi' il filtro lasciato su
     un'altra classe non nasconde queste righe. Valori ignoti o corrotti
     mostrano tutto: senza, le righe restano nascoste e i dati "svaniscono"
     dopo il caricamento. */
  var filtroChiave = 'assenze_quadro_G.filtro.{{ classe ? classe.id : 0 }}';
  $('#gs-filtro-alunni').change(function() {
    var f = $(this).val();
    if (f == 'T' || !filtro[f]) {
      $('.gs-alunno-riga').show();
      f = 'T';
      $(this).val(f);
    } else {
      $('.gs-alunno-riga').hide();
      for (var i = 0; i < filtro[f].length; i++) {
        $('#gs-alunno-' + filtro[f][i]).show();
      }
    }
    sessionStorage.setItem(filtroChiave, f);
  });
  // init
  var filtro = [];
  filtro['S'] = [{% for a in dati.filtro['S'] %}{{ a }}{{ not loop.last ? ',' }}{% endfor %}];
  filtro['A'] = [{% for a in dati.filtro['A'] %}{{ a }}{{ not loop.last ? ',' }}{% endfor %}];
  filtro['N'] = [{% for a in dati.filtro['N'] %}{{ a }}{{ not loop.last ? ',' }}{% endfor %}];
  if ($('#gs-filtro-alunni').length) {
    var fv = sessionStorage.getItem(filtroChiave);
    if (fv != 'T' && fv != 'S' && fv != 'A' && fv != 'N') {
      fv = 'T';
    }
    $('#gs-filtro-alunni').val(fv).change();
  }
  {% if posizione > 0 %}
  $('html').scrollTop({{ posizione }});
  {% endif %}
});
</script>
{% endblock %}

{% extends 'lezioni/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not cattedra and not classe %}
  <h1 class="text-center gs-h1 gs-mt-2">{{ 'title.lezioni_voti'|trans }}</h1>
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.cattedra_mancante'|trans }}</strong>
  </div>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context: false) }}
  {% elseif not cattedra %}
  <h1 class="text-center gs-h1 gs-mt-2">{{ 'title.lezioni_voti'|trans }}</h1>
  {# selettore sede/classe per le sostituzioni: c'e' anche qui, cosi' dalla
     classe sbagliata si puo' passare subito a un'altra senza tornare indietro #}
  {{ include('include/selettore-classe.html.twig', {}, with_context: false) }}
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.voti_sostituzione'|trans }}</strong>
  </div>
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-0">{{ 'title.lezioni_voti'|trans }} {{ classe }}</h1>
  <h2 class="text-center gs-h2 gs-mt-0 gs-mb-4"><em>{{ info.materia }}</em></h2>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context: false) }}
  <div class="row text-center gs-big gs-mb-2"><em>Clicca su un voto per modificarlo o eliminarlo.</em></div>
  <div class="gs-voti-toolbar">
    <div class="gs-voti-toolbar-main">
      <span class="gs-voti-toolbar-label">Periodo:</span>
      <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" id="gs-dropdown-menu" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true" title="Clicca per scegliere il periodo">{{ periodo ? lista_periodi[periodo].nome : 'Scegli' }}<span class="caret gs-ml-3"></span></button>
        <ul class="dropdown-menu" aria-labelledby="gs-dropdown-menu">
    {% for p, d in lista_periodi %}
      {% if d.nome %}
          <li{{ periodo == p ? ' class="active"' }}><a href="{{ path('lezioni_voti_quadro', {cattedra: cattedra.id, classe: classe.id, periodo: p}) }}">{{ d.nome }}</a></li>
      {% endif %}
    {% endfor %}
        </ul>
      </div>
      <a class="btn btn-default btn-sm" href="{{ path('lezioni_voti_configura') }}" role="button" title="Configura la visualizzazione della pagina dei voti">{{ include('admin/include/icona.html.twig', {nome: 'pin', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Visualizzazione</strong></a>
    </div>
    {% if periodo %}
    <div class="gs-voti-toolbar-actions">
      <a class="btn btn-default btn-sm" href="{{ path('lezioni_voti_esporta', {cattedra: cattedra.id, classe: classe.id, data: lista_periodi[periodo].fine}) }}" role="button" title="Esporta i dati in formato CSV">{{ include('admin/include/icona.html.twig', {nome: 'download', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>{{ 'label.esporta'|trans }}</strong></a>
      <a class="btn btn-default btn-sm" href="{{ path('lezioni_voti_stampa', {cattedra: cattedra.id, classe: classe.id, data: lista_periodi[periodo].fine}) }}" role="button" title="Scarica il documento in formato PDF">{{ include('admin/include/icona.html.twig', {nome: 'printer', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>{{ 'label.stampa'|trans }}</strong></a>
      <a class="btn btn-default btn-sm" href="{{ path('lezioni_voti_dettagli', {cattedra: cattedra.id, classe: classe.id}) }}" role="button" title="Visualizza i dettagli delle valutazioni">{{ include('admin/include/icona.html.twig', {nome: 'zoom-in', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Dettagli</strong></a>
    </div>
    {% endif %}
  </div>

  <div class="gs-voti-legenda" aria-label="Legenda dei colori del quadro voti">
    <span class="gs-voti-legenda-titolo">Legenda:</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-s">S</span> Scritto/Grafico</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-o">O</span> Orale</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-p">P</span> Pratico</span>
    <span class="gs-voti-legenda-sep" aria-hidden="true"></span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-success">6</span> Sufficiente</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-warning">5</span> Soglia</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-danger">4</span> Insufficiente</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-default">&ndash;</span> Non visibile / non in media</span>
    <span class="gs-voti-legenda-voce"><span class="gs-voti-swatch gs-voti-swatch-info">7</span> Altro docente</span>
  </div>
    {% if info.pagina.compatta %}
  <div class="gs-table-sticky-wrapper">
  {% set intestazione_grezza_0 %}      <thead>
        <tr>
          <th rowspan="2" class="gs-col-sticky gs-color-1">Alunno</th>
      {% if info.pagina.scritto %}
          <th colspan="{{ 1 + info.pagina.medie_tipi + edit }}" class="gs-color-2">Scritto/Grafico</th>
      {% endif %}
      {% if info.pagina.orale %}
          <th colspan="{{ 1 + info.pagina.medie_tipi + edit }}" class="gs-color-3">Orale</th>
      {% endif %}
      {% if info.pagina.pratico %}
          <th colspan="{{ 1 + info.pagina.medie_tipi + edit }}" class="gs-color-4">Pratico</th>
      {% endif %}
          <th rowspan="2" class="gs-color-1">Media</th>
        </tr>
        <tr>
      {% if info.pagina.scritto %}
          <th class="gs-color-2">Voti</th>
        {% if info.pagina.medie_tipi %}
          <th class="gs-color-2"><em class="gs-color-5">Media<br>S/G</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-2"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'S'}) }}" role="button" title="Aggiungi una valutazione Scritta/Grafica per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
      {% if info.pagina.orale %}
          <th class="gs-color-3">Voti</th>
        {% if info.pagina.medie_tipi %}
          <th class="gs-color-3"><em class="gs-color-5">Media<br>O</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-3"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'O'}) }}" role="button" title="Aggiungi una valutazione Orale per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
      {% if info.pagina.pratico %}
          <th class="gs-color-4">Voti</th>
        {% if info.pagina.medie_tipi %}
          <th class="gs-color-4"><em class="gs-color-5">Media<br>P</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-4"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'P'}) }}" role="button" title="Aggiungi una valutazione Pratica per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
        </tr>
      </thead>{% endset %}

{% set corpo_grezzo_0 %}
      {% for k, a in dati.alunni %}
        {% if (cattedra.materia.tipo != 'R' or a.religione == info.religioneTipo) and dati.trasferiti[a.id] is not defined %}
        <tr>
          <td class="gs-col-sticky gs-pt-1 gs-pb-1">
            {{ include('include/bottone-azione.html.twig', {nome: 'eye', etichetta: 'Dettagli alunno', titolo: 'Dettagli alunno', stile: 'default', classi: 'pull-left gs-mr-2', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-info', 'data-title': a.cognome ~ ' ' ~ a.nome ~ ' (' ~ a.dataNascita|date('d/m/Y') ~ ')', 'data-body': 'alunno-' ~ loop.index}}) }}
            <strong>{{ a.cognome }} {{ a.nome }}</strong><br><small>({{ a.dataNascita|date('d/m/Y') }})</small>
            {{ include('include/scheda-alunno.html.twig', {id: loop.index, a: a, g: dati.genitori[a.id]}) }}
          </td>
          {% for tipo in info.pagina.tipi %}
          <td style="text-align:left;">
            {% for d, dd in dati.lista[tipo] %}
              {% if dati.voti[k][tipo][d] is defined %}
                {% set v = dati.voti[k][tipo][d] %}
                {% if v.docente_id != app.user.id %}
            <button type="button" class="btn btn-xs btn-info" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{% if v.voto > 0 %}{{ v.voto_str }}{% else %}{{ include('admin/include/icona.html.twig', {nome: 'asterisk', stile: 'outline'}) }}{% endif %}</strong></button>
                {% elseif v.voto > 0 and not v.visibile %}
            <button type="button" class="btn btn-xs btn-default" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% elseif v.voto > 0 and not v.media %}
            <button type="button" class="btn btn-xs gs-btn-secondary" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% elseif v.voto > 0 %}
            <button type="button" class="btn btn-xs btn-{{ v.voto < 5 ? 'danger' : (v.voto < 6 ? 'warning' : 'success') }}" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% else %}
            <button type="button" class="btn btn-xs btn-default" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}">{{ include('admin/include/icona.html.twig', {nome: 'asterisk', stile: 'outline', classe: 'gs-big'}) }}</button>
                {% endif %}
            <div id="gs-voti-{{ v.id }}" style="display:none">
              <div class="list-group-item">
                <div class="list-group-item-text">
                  <p>
                {% if not v.visibile %}
                    {{ include('admin/include/icona.html.twig', {nome: 'eye-off', stile: 'outline', classe: 'text-danger gs-mr-2', titolo: 'Non visibile ai genitori'}) }}
                {% endif %}
                    <strong>Data:</strong> {{ v.data|date('d/m/Y') }}
                  </p>
                  <p><strong>Docente:</strong> {{ v.nome }} {{ v.cognome }}</p>
                  <p><strong>Valutazione:</strong> {{ ('label.voti_' ~ v.tipo)|trans }} <em>{{ not v.media ? '(non utilizzata nel calcolo della media)' }}</em></p>
                  <p><strong>Alunno:</strong> {{ a.cognome }} {{ a.nome }} ({{ a.dataNascita|date('d/m/Y') }})</p>
                {% if v.argomento is not empty %}
                  <p><strong>Argomenti o descrizione della prova:</strong><br>{{ v.argomento }}</p>
                {% endif %}
                {% if v.voto_str is defined %}
                  <p><strong>Voto:</strong> {{ v.voto_str }}</p>
                {% endif %}
                {% if v.giudizio is not empty %}
                  <p><strong>Giudizio:</strong><br>{{ v.giudizio }}</p>
                {% endif %}
                </div>
                {% if v.docente_id == app.user.id and edit %}
                <div class="list-group-item-text text-right">
                  <a class="btn btn-primary btn-sm" href="{{ path('lezioni_voti_alunno', {cattedra: cattedra.id, alunno: a.id, tipo: v.tipo, id: v.id}) }}" role="button" title="Modifica la valutazione">Modifica</a>
                  <button type="button" class="btn btn-danger btn-sm gs-ml-2 gs-modal-confirm-button" title="Elimina la valutazione" data-toggle="modal" data-target="#gs-modal-confirm" data-titolo="{{ v.alunno }}" data-contenuto="{{ 'message.cancella_voto'|trans }}" data-href="{{ path('lezioni_voti_cancella', {id: v.id}) }}" data-csrf="{{ csrf_token('delete') }}">Cancella</button>
                </div>
                {% endif %}
              </div>
            </div>
              {% endif %}
            {% endfor %}
          </td>
            {% if info.pagina.medie_tipi %}
          <td class="{{ dati.medie[k][tipo] < 5 ? 'text-danger' : (dati.medie[k][tipo] < 6 ? 'text-warning' : 'text-success') }}"><em class="gs-big">{{ dati.medie[k][tipo] ? dati.medie[k][tipo]|number_format(app.session.get('/CONFIG/SISTEMA/precisione_media'), ',') }}</em></td>
            {% endif %}
            {% if edit %}
          <td><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_alunno', {cattedra: cattedra.id, alunno: a.id, tipo: tipo}) }}" role="button" title="Aggiungi una valutazione {{ tipo == 'S' ? 'Scritta/Grafica' : (tipo == 'O' ? 'Orale' : 'Pratica') }} per l'alunno"><strong class="gs-big">{{ tipo }}</strong></a></td>
            {% endif %}
          {% endfor %}
          <td class="{{ dati.medie[k]['T'] < 5 ? 'text-danger' : (dati.medie[k]['T'] < 6 ? 'text-warning' : 'text-success') }}"><strong class="gs-big">{{ dati.medie[k]['T'] ? dati.medie[k]['T']|number_format(app.session.get('/CONFIG/SISTEMA/precisione_media'), ',') }}</strong></td>
        </tr>
        {% endif %}
      {% endfor %}
      {% endset %}
    {{ include('include/tabella.html.twig', {intestazione_grezza: intestazione_grezza_0, corpo_grezzo: corpo_grezzo_0, classi: 'gs-table-sticky'}) }}
  </div>
    {% else %}
  <div class="gs-table-sticky-wrapper">
    {% set intestazione_grezza_1 %}      <thead>
        <tr>
          <th rowspan="2" class="gs-col-sticky gs-color-1">Alunno</th>
      {% if info.pagina.scritto %}
          <th colspan="{{ dati.lista.S|keys|length + info.pagina.medie_tipi + edit }}" class="gs-color-2">Scritto/Grafico</th>
      {% endif %}
      {% if info.pagina.orale %}
          <th colspan="{{ dati.lista.O|keys|length + info.pagina.medie_tipi + edit }}" class="gs-color-3">Orale</th>
      {% endif %}
      {% if info.pagina.pratico %}
          <th colspan="{{ dati.lista.P|keys|length + info.pagina.medie_tipi + edit }}" class="gs-color-4">Pratico</th>
      {% endif %}
          <th rowspan="2" class="gs-color-1">Media</th>
        </tr>
        <tr>
      {% if info.pagina.scritto %}
        {% for d in dati.lista.S|keys %}
          <th class="gs-color-2">
          {% if edit %}
            <a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'S', data: d[7:]}) }}" role="button" title="{% if dati.lista.S[d] is empty %}Modifica la valutazione Scritta/Grafica per la classe{% else %}Modifica la valutazione Scritta/Grafica: {{ dati.lista.S[d] }}{% endif %}"><strong class="gs-big">{{ d[0:3] }}<br>{{ d[4:2] }}</strong></a>
          {% else %}
            {{ d[0:3] }}<br>{{ d[4:2] }}
          {% endif %}
          </th>
        {% endfor %}
        {% if info.pagina.medie_tipi %}
          <th class="gs-color-2"><em class="gs-color-5">Media<br>S/G</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-2"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'S'}) }}" role="button" title="Aggiungi una valutazione Scritta/Grafica per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
      {% if info.pagina.orale %}
        {% for d in dati.lista.O|keys %}
          <th class="gs-color-3">
          {% if edit %}
            <a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'O', data: d[7:]}) }}" role="button" title="{% if dati.lista.O[d] is empty %}Modifica la valutazione Orale per la classe{% else %}Modifica la valutazione Orale: {{ dati.lista.O[d] }}{% endif %}"><strong class="gs-big">{{ d[0:3] }}<br>{{ d[4:2] }}</strong></a>
          {% else %}
            {{ d[0:3] }}<br>{{ d[4:2] }}
          {% endif %}
          </th>
        {% endfor %}
        {% if info.pagina.medie_tipi %}
          <th class="gs-color-3"><em class="gs-color-5">Media<br>O</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-3"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'O'}) }}" role="button" title="Aggiungi una valutazione Orale per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
      {% if info.pagina.pratico %}
        {% for d in dati.lista.P|keys %}
          <th class="gs-color-4">
          {% if edit %}
            <a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'P', data: d[7:]}) }}" role="button" title="{% if dati.lista.P[d] is empty %}Modifica la valutazione Pratica per la classe{% else %}Modifica la valutazione Pratica: {{ dati.lista.P[d] }}{% endif %}"><strong class="gs-big">{{ d[0:3] }}<br>{{ d[4:2] }}</strong></a>
          {% else %}
            {{ d[0:3] }}<br>{{ d[4:2] }}
          {% endif %}
          </th>
        {% endfor %}
        {% if info.pagina.medie_tipi %}
        <th class="gs-color-4"><em class="gs-color-5">Media<br>P</em></th>
        {% endif %}
        {% if edit %}
          <th class="gs-color-4"><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_classe', {cattedra: cattedra.id, tipo: 'P'}) }}" role="button" title="Aggiungi una valutazione Pratica per la classe">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline'}) }}</a></th>
        {% endif %}
      {% endif %}
        </tr>
      </thead>{% endset %}

    {% set corpo_grezzo_1 %}
      {% for k, a in dati.alunni %}
        {% if (cattedra.materia.tipo != 'R' or a.religione == info.religioneTipo) and dati.trasferiti[a.id] is not defined %}
        <tr>
          <td class="gs-col-sticky gs-pt-1 gs-pb-1">
            {{ include('include/bottone-azione.html.twig', {nome: 'eye', etichetta: 'Dettagli alunno', titolo: 'Dettagli alunno', stile: 'default', classi: 'pull-left gs-mr-2', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-info', 'data-title': a.cognome ~ ' ' ~ a.nome ~ ' (' ~ a.dataNascita|date('d/m/Y') ~ ')', 'data-body': 'alunno-' ~ loop.index}}) }}
            <strong>{{ a.cognome }} {{ a.nome }}</strong> <small>({{ a.dataNascita|date('d/m/Y') }})</small>
            {{ include('include/scheda-alunno.html.twig', {id: loop.index, a: a, g: dati.genitori[a.id]}) }}
          </td>
          {% for tipo in info.pagina.tipi %}
            {% for d, dd in dati.lista[tipo] %}
          <td>
              {% if dati.voti[k][tipo][d] is defined %}
                {% set v = dati.voti[k][tipo][d] %}
                {% if v.docente_id != app.user.id %}
            <button type="button" class="btn btn-xs btn-info" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{% if v.voto > 0 %}{{ v.voto_str }}{% else %}{{ include('admin/include/icona.html.twig', {nome: 'asterisk', stile: 'outline'}) }}{% endif %}</strong></button>
                {% elseif v.voto > 0 and not v.visibile %}
            <button type="button" class="btn btn-xs btn-default" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% elseif v.voto > 0 and not v.media %}
            <button type="button" class="btn btn-xs gs-btn-secondary" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% elseif v.voto > 0 %}
            <button type="button" class="btn btn-xs btn-{{ v.voto < 5 ? 'danger' : (v.voto < 6 ? 'warning' : 'success') }}" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}"><strong class="gs-big">{{ v.voto_str }}</strong></button>
                {% else %}
            <button type="button" class="btn btn-xs btn-default" title="Informazioni sulla valutazione" data-toggle="modal" data-target="#gs-modal-info" data-title="Informazioni sulla valutazione" data-body="gs-voti-{{ v.id }}">{{ include('admin/include/icona.html.twig', {nome: 'asterisk', stile: 'outline', classe: 'gs-big'}) }}</button>
                {% endif %}
            <div id="gs-voti-{{ v.id }}" style="display:none">
              <div class="list-group-item">
                <div class="list-group-item-text">
                  <p>
                {% if not v.visibile %}
                    {{ include('admin/include/icona.html.twig', {nome: 'eye-off', stile: 'outline', classe: 'text-danger gs-mr-2', titolo: 'Non visibile ai genitori'}) }}
                {% endif %}
                    <strong>Data:</strong> {{ v.data|date('d/m/Y') }}
                  </p>
                  <p><strong>Docente:</strong> {{ v.nome }} {{ v.cognome }}</p>
                  <p><strong>Valutazione:</strong> {{ ('label.voti_' ~ v.tipo)|trans }} <em>{{ not v.media ? '(non utilizzata nel calcolo della media)' }}</em></p>
                  <p><strong>Alunno:</strong> {{ a.cognome }} {{ a.nome }} ({{ a.dataNascita|date('d/m/Y') }})</p>
                {% if v.argomento is not empty %}
                  <p><strong>Argomenti o descrizione della prova:</strong><br>{{ v.argomento }}</p>
                {% endif %}
                {% if v.voto_str is defined %}
                  <p><strong>Voto:</strong> {{ v.voto_str }}</p>
                {% endif %}
                {% if v.giudizio is not empty %}
                  <p><strong>Giudizio:</strong><br>{{ v.giudizio }}</p>
                {% endif %}
                </div>
                {% if v.docente_id == app.user.id and edit %}
                <div class="list-group-item-text text-right">
                  <a class="btn btn-primary btn-sm" href="{{ path('lezioni_voti_alunno', {cattedra: cattedra.id, alunno: a.id, tipo: v.tipo, id: v.id}) }}" role="button" title="Modifica la valutazione">Modifica</a>
                  <button type="button" class="btn btn-danger btn-sm gs-ml-2 gs-modal-confirm-button" title="Elimina la valutazione" data-toggle="modal" data-target="#gs-modal-confirm" data-titolo="{{ v.alunno }}" data-contenuto="{{ 'message.cancella_voto'|trans }}" data-href="{{ path('lezioni_voti_cancella', {id: v.id}) }}" data-csrf="{{ csrf_token('delete') }}">Cancella</button>
                </div>
                {% endif %}
              </div>
            </div>
              {% else %}
            &nbsp;
              {% endif %}
            {% endfor %}
          </td>
            {% if info.pagina.medie_tipi %}
          <td class="{{ dati.medie[k][tipo] < 5 ? 'text-danger' : (dati.medie[k][tipo] < 6 ? 'text-warning' : 'text-success') }}"><em class="gs-big">{{ dati.medie[k][tipo] ? dati.medie[k][tipo]|number_format(app.session.get('/CONFIG/SISTEMA/precisione_media'), ',') }}</em></td>
            {% endif %}
            {% if edit %}
          <td><a class="btn btn-default btn-xs" href="{{ path('lezioni_voti_alunno', {cattedra: cattedra.id, alunno: a.id, tipo: tipo}) }}" role="button" title="Aggiungi una valutazione {{ tipo == 'S' ? 'Scritta/Grafica' : (tipo == 'O' ? 'Orale' : 'Pratica') }} per l'alunno"><strong class="gs-big">{{ tipo }}</strong></a></td>
            {% endif %}
          {% endfor %}
          <td class="{{ dati.medie[k]['T'] < 5 ? 'text-danger' : (dati.medie[k]['T'] < 6 ? 'text-warning' : 'text-success') }}"><strong class="gs-big">{{ dati.medie[k]['T'] ? dati.medie[k]['T']|number_format(app.session.get('/CONFIG/SISTEMA/precisione_media'), ',') }}</strong></td>
        </tr>
        {% endif %}
      {% endfor %}
      {% endset %}
    {{ include('include/tabella.html.twig', {intestazione_grezza: intestazione_grezza_1, corpo_grezzo: corpo_grezzo_1, classi: 'gs-table-sticky'}) }}
  </div>
    {% endif %}
    {{ include('include/modal-info.html.twig') }}
  {% endif %}
  {{ include('admin/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('[data-toggle="popover"]').popover();
  $('#gs-modal-info').on('show.bs.modal', function (event) {
    var title = $(event.relatedTarget).data('title');
    var id = $(event.relatedTarget).data('body');
    var html = $('#'+id).html();
    $(this).find('#gs-modal-info-label').text(title);
    $(this).find('#gs-modal-info-body').html(html);
  });
  $('#gs-modal-info').on('shown.bs.modal', function (e) {
    $('body').addClass('modal-open');
    $('button.gs-show-hide').on('click', function (e) {
      var el = $(this).parent().siblings('div');
      if (el.is(':visible')) {
        el.fadeOut();
        $(this).attr('title', 'Apre la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize');
      } else {
        el.fadeIn();
        $(this).attr('title', 'Chiude la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize');
      }
    });
  });
  $('.gs-table-sticky td').on('mouseenter', function() {
    var index = $(this).index();
    if (index > 0) {
      $('.gs-table-sticky tr').each(function() {
        $(this).find('td').eq(index).addClass('gs-hover');
      });
    }
  });
  $('.gs-table-sticky td').on('mouseleave', function() {
    var index = $(this).index();
    if (index > 0) {
      $('.gs-table-sticky tr').each(function() {
        $(this).find('td').eq(index).removeClass('gs-hover');
      });
    }
  });
  $('#gs-modal-confirm').on('show.bs.modal', function(e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}

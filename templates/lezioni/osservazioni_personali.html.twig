{% extends 'lezioni/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not cattedra and not classe %}
  <h1 class="text-center gs-h1 gs-mt-2">{{ include('admin/include/icona.html.twig', {nome: 'eye-off', stile: 'outline', classe: 'text-danger gs-mr-3', titolo: 'Non visibile ai genitori'}) }}{{ 'title.lezioni_osservazioni_personali'|trans }}</h1>
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.cattedra_mancante'|trans }}</strong>
  </div>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context = false) }}
  {% elseif not cattedra %}
  <h1 class="text-center gs-h1 gs-mt-2">{{ include('admin/include/icona.html.twig', {nome: 'eye-off', stile: 'outline', classe: 'text-danger gs-mr-3', titolo: 'Non visibile ai genitori'}) }}{{ 'title.lezioni_osservazioni_personali'|trans }}</h1>
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.osservazioni_sostituzione'|trans }}</strong>
  </div>
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-0">{{ include('admin/include/icona.html.twig', {nome: 'eye-off', stile: 'outline', classe: 'text-danger gs-mr-3', titolo: 'Non visibile ai genitori'}) }}{{ 'title.lezioni_osservazioni_personali'|trans }} {{ classe }}</h1>
  <h2 class="text-center gs-h2 gs-mt-0 gs-mb-5"><em>{{ info.materia }}{% if info.alunno %}<button type="button" class="btn btn-xs btn-default gs-ml-3" title="Informazioni sulla cattedra" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ info.alunno }}">{{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}</button>{% endif %}</em></h2>
  {# selettore sede/classe per le sostituzioni #}
  {{ include('include/selettore-classe.html.twig', {}, with_context = false) }}
  <div class="row gs-mb-4">
    <div class="col-sm-6">
      {% if data_prec %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_osservazioni_personali', {cattedra: cattedra.id, classe: classe.id, data: data_prec|date('Y-m-d')}) }}" role="button" title="Giorno precedente">{{ include('admin/include/icona.html.twig', {nome: 'chevron-left', stile: 'outline'}) }}</a>{% endif %}
      <button class="btn btn-primary gs-pt-2 gs-pb-2" id="gs-button-date" title="Cambia data">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline', classe: 'gs-mr-3'}) }}<strong>{{ info.data_label }}</strong></button>
      {% if data_succ %}<a class="btn btn-success btn-sm" href="{{ path('lezioni_osservazioni_personali', {cattedra: cattedra.id, classe: classe.id, data: data_succ|date('Y-m-d')}) }}" role="button" title="Giorno successivo">{{ include('admin/include/icona.html.twig', {nome: 'chevron-right', stile: 'outline'}) }}</a>{% endif %}
    </div>
    <div class="col-sm-6 text-right">
      <a class="btn btn-success btn-sm" href="{{ path('lezioni_osservazioni') }}" role="button" title="Visualizza le osservazioni sugli alunni">{{ include('admin/include/icona.html.twig', {nome: 'hand-stop', stile: 'outline', classe: 'gs-mr-3'}) }}<strong>Osservazioni sugli alunni</strong></a>
    </div>
  </div>
    {% if errore %}
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ errore }}</strong>
  </div>
    {% else %}
      {% for periodo, v in dati.lista %}
  <div class="row gs-mt-4 gs-mb-2">
    <div class="col-sm-6 text-info">
      <strong class="gs-big">{{ periodo }}</strong>
    </div>
    <div class="col-sm-6 text-right">
        {% if dati.add is defined %}
      <a class="btn btn-primary btn-xs" href="{{ dati.add }}" role="button" title="Aggiungi un'osservazione personale">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}{{ 'label.add'|trans }}</a>
        {% endif %}
    </div>
  </div>
  {% set intestazione = [
      {contenuto: 'Data', scope: 'col'},
      {contenuto: 'Osservazioni', scope: 'col'},
      {contenuto: 'Azioni', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
        {% for data, v1 in v %}
          {% for e in v1 %}
      <tr>
        <td><strong>{{ e.data }}</strong></td>
        <td><small>{{ e.testo|raw|nl2br }}</small></td>
        <td>
            {% if e.edit %}
          {{ include('include/bottone-azione.html.twig', {nome: 'pencil', etichetta: 'Modifica', titolo: 'Modifica l\'osservazione personale', classi: 'gs-mr-2', url: e.edit}) }}
            {% endif %}
            {% if e.delete %}
          {{ include('include/bottone-azione.html.twig', {nome: 'trash', etichetta: 'Cancella', titolo: 'Cancella l\'osservazione personale', stile: 'danger', classi: 'gs-modal-confirm-button', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-href': e.delete, 'data-text': 'message.cancella_osservazione'|trans, 'data-csrf': csrf_token('delete')}}) }}
            {% endif %}
        </td>
      </tr>
          {% endfor %}
        {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
      {% else %}
        {% if dati.add is defined %}
      <div><a class="btn btn-primary btn-xs pull-right" href="{{ dati.add }}" role="button" title="Aggiungi un'osservazione personale">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}{{ 'label.add'|trans }}</a></div>
        {% endif %}
      {% endfor %}
      {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.cancella_lezione'}) }}
    {% endif %}
  {% endif %}
</div>
{% endblock %}

{% block pagina_css %}
{{ parent() }}
<link href="{{ asset('vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet">
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js') }}"></script>
<script src="{{ asset('vendor/bootstrap-datepicker/locales/bootstrap-datepicker.it.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('#gs-button-date').datepicker({
    format: "yyyy-mm-dd",
    weekStart: 1,
    maxViewMode: 1,
    daysOfWeekDisabled: "0",
    defaultViewDate: "{{ data }}",
    startDate: "{{ app.session.get('/CONFIG/SCUOLA/anno_inizio') }}",
    endDate: "{{ app.session.get('/CONFIG/SCUOLA/anno_fine') }}",
    {% if lista_festivi %}datesDisabled: {{ lista_festivi|raw }},{% endif %}
    todayBtn: "linked",
    todayHighlight: true,
    autoclose: true,
    language: "it",
    zIndexOffset: 1200
    });
  $('#gs-button-date').datepicker()
    .on('show', function(ev){
      $('#gs-button-date').datepicker('update', '{{ data }}');
  });
  $('#gs-button-date').datepicker()
    .on('changeDate', function(ev){
      $('#gs-button-date').datepicker('hide');
      url = "{{ path('lezioni_osservazioni_personali', {cattedra: (cattedra ? cattedra.id : 0), classe: (classe ? classe.id : 0), data: '9999-99-99'}) }}";
      url = url.replace("9999-99-99", ev.format());
      window.location.href = url;
  });
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
});
  $('[data-toggle="popover"]').popover();
});
</script>
{% endblock %}

{# NOSONAR Web:S6819 - role="dialog"/"document" sono richiesti dal markup Bootstrap 4 della modale: #}
{# rimuoverli romperebbe lo stile .modal/.modal-dialog e la gestione della finestra da parte del JS. #}
<div class="modal fade" id="gs-modal-confirm" tabindex="-1" role="dialog" aria-labelledby="gs-modal-confirm-label">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span class="glyphicon glyphicon-remove gs-mr-2" aria-hidden="true"></span>
          <span class="sr-only">{{ 'label.close'|trans }}</span>
        </button>
        <h3 class="modal-title" id="gs-modal-confirm-label"><strong>{{ 'label.warning'|trans }}</strong></h3>
      </div>
      <div class="modal-body">
        <p id="gs-modal-confirm-msg">{{ modal_confirm_msg|trans }}</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ 'label.cancel'|trans }}</button>
        <form id="gs-modal-confirm-form" method="post" action="#" style="display:inline">
          <input type="hidden" name="_csrf_token" id="gs-modal-confirm-csrf">
          <button type="submit" class="btn btn-primary">{{ 'label.continua'|trans }}</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% extends 'colloqui/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-2">{{ titolo|trans }}</h1>
  {% if dati|length == 0 %}
  <div class="alert alert-warning text-center gs-big"><strong>Non hai inserito i ricevimenti dei genitori</strong></div>
  {% else %}
    {{ include('admin/include/flash.html.twig') }}
  {% set intestazione = [
    {contenuto: 'label.colloquio_ricevimento'|trans, scope: 'col'},
    {contenuto: 'label.sede'|trans, scope: 'col'},
    {contenuto: 'label.tipo'|trans, scope: 'col'},
    {contenuto: 'label.colloquio_luogo'|trans, scope: 'col'},
    {contenuto: 'label.colloquio_durata'|trans, scope: 'col'},
    {contenuto: 'label.action'|trans, scope: 'col'}
  ] %}
  {% set righe = [] %}
  {% for d in dati %}
    {% set scaduto = d.ricevimento.data < date('today') %}
    {# prima cella: simbolo di stato + data, con lo stesso testo di prima #}
    {% set prima %}
      {%- if scaduto -%}
        {{ include('admin/include/icona.html.twig', {nome: 'circle-x', stile: 'outline', classe: 'gs-mr-2 text-danger'}) }}
        <em>{{ d.ricevimento.data|format_date('full')|title }} dalle {{ d.ricevimento.inizio|date('G:i') }} alle {{ d.ricevimento.fine|date('G:i') }}</em>
      {%- elseif d.ricevimento.abilitato -%}
        {{ include('admin/include/icona.html.twig', {nome: 'check', stile: 'outline', classe: 'gs-mr-2 text-success'}) }}
        <strong>{{ d.ricevimento.data|format_date('full')|title }} dalle {{ d.ricevimento.inizio|date('G:i') }} alle {{ d.ricevimento.fine|date('G:i') }}</strong>
      {%- else -%}
        {{ include('admin/include/icona.html.twig', {nome: 'circle-x', stile: 'outline', classe: 'gs-mr-2 text-danger'}) }}
        <strong>{{ d.ricevimento.data|format_date('full')|title }} dalle {{ d.ricevimento.inizio|date('G:i') }} alle {{ d.ricevimento.fine|date('G:i') }}</strong>
      {%- endif -%}
    {% endset %}
    {# pulsanti di riga: solo icona #}
    {% set pulsanti = [] %}
    {% if not scaduto %}
      {% if d.ricevimento.abilitato and d.richieste > 0 %}
        {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
          nome: 'pencil', etichetta: 'label.edit'|trans, titolo: 'Modifica le impostazioni del ricevimento indicato',
          stile: 'warning', classi: 'gs-modal-confirm-button',
          attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm',
                      'data-href': path('colloqui_edit', {id: d.ricevimento.id}),
                      'data-text': 'message.colloquio_modifica_con_richieste'|trans,
                      'data-csrf': csrf_token('delete')}})]) %}
      {% else %}
        {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
          nome: 'pencil', etichetta: 'label.edit'|trans, titolo: 'Modifica le impostazioni del ricevimento indicato',
          url: path('colloqui_edit', {id: d.ricevimento.id})})]) %}
      {% endif %}
      {% if d.ricevimento.abilitato and d.richieste == 0 %}
        {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
          nome: 'circle-x', etichetta: 'Disabilita', titolo: 'Disabilita il ricevimento indicato', stile: 'danger',
          url: path('colloqui_enable', {id: d.ricevimento.id, stato: 0})})]) %}
      {% elseif not d.ricevimento.abilitato %}
        {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
          nome: 'check', etichetta: 'Abilita', titolo: 'Abilita il ricevimento indicato', stile: 'success',
          url: path('colloqui_enable', {id: d.ricevimento.id, stato: 1})})]) %}
      {% endif %}
    {% endif %}
    {# le celle scadute restano in corsivo: era cosi' prima #}
    {% set apri = scaduto ? '<em>' : '' %}
    {% set chiudi = scaduto ? '</em>' : '' %}
    {% set righe = righe|merge([{
      classi: d.ricevimento.abilitato ? '' : 'danger',
      celle: [
        {contenuto: prima},
        {contenuto: apri ~ d.ricevimento.sede.nomeBreve ~ chiudi},
        {contenuto: apri ~ ('label.tipo_colloquio_' ~ d.ricevimento.tipo)|trans ~ chiudi},
        {contenuto: apri ~ '<small>' ~ d.ricevimento.luogo ~ '</small>' ~ chiudi},
        {contenuto: apri ~ d.ricevimento.durata ~ ' minuti (' ~ d.ricevimento.numero ~ ' colloqui)' ~ chiudi},
        {contenuto: pulsanti}
      ]}]) %}
  {% endfor %}
  {{ include('include/tabella.html.twig', {intestazione: [intestazione], corpo: righe}) }}
  {% endif %}
  <div class="text-right gs-mt-4">
    <a class="btn btn-primary gs-mr-3 gs-mb-1" href="{{ path('colloqui_edit') }}" role="button" title="Aggiungi un singolo ricevimento indicando data e ora"><strong>Aggiungi ricevimento singolo</strong></a>
    <a class="btn btn-primary gs-mr-3 gs-mb-1" href="{{ path('colloqui_create') }}" role="button" title="Aggiungi più ricevimenti indicando la periodicità"><strong>Aggiungi ricevimenti periodici</strong></a>
    <button class="btn btn-danger gs-modal-confirm-button gs-mr-3 gs-mb-1" title="Cancella i ricevimenti disabilitati" data-toggle="modal" data-target="#gs-modal-confirm" data-href="{{ path('colloqui_delete', {tipo: 'D'}) }}" data-text="{{ 'message.colloquio_cancella_disabilitati'|trans }}" data-csrf="{{ csrf_token('delete') }}"><strong>Cancella disabilitati</strong></button>
    <button class="btn btn-danger gs-modal-confirm-button gs-mr-3 gs-mb-1" title="Cancella tutti i ricevimenti senza richieste" data-toggle="modal" data-target="#gs-modal-confirm" data-href="{{ path('colloqui_delete', {tipo: 'T'}) }}" data-text="{{ 'message.colloquio_cancella_tutti'|trans }}" data-csrf="{{ csrf_token('delete') }}"><strong>Cancella tutti</strong></button>
  </div>
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.colloquio_modifica_con_richieste'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
});
});
</script>
{% endblock %}

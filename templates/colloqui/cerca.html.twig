{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-colloqui-cerca">
  <h1 class="text-center gs-h2 gs-mt-2">{{ titolo|trans }}</h1>
  <form name="{{ form[0].vars.name }}" method="{{ form[0].vars.method }}" action="{{ form[0].vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form[0].vars.id }}">
      <div class="gs-filters-row">
        <div class="gs-filter-col">
          {{ form_label(form[0].docente, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form[0].docente) }}
        </div>
      </div>
      {% if form[0].data is defined %}
        <div class="gs-filters-row">
          <div class="gs-filter-col">
            {{ form_label(form[0].data, null, {label_attr: {class: 'control-label'}}) }}
            {{ form_widget(form[0].data) }}
          </div>
        </div>
      {% endif %}
      <div class="gs-filters-buttons">
        {{ form_widget(form[0].submit) }}
      </div>
      {{ form_widget(form[0]._token) }}
    </div>
  </form>
  {% if dati|length == 0 %}
  <div class="alert alert-info text-center gs-big">
    <strong>Non sono presenti dati</strong>
  </div>
  {% else %}
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h3 class="panel-title text-center">
        <strong>{{ dati[0].docente.cognome }} {{ dati[0].docente.nome }}</strong>
      </h3>
    </div>
    {% set intestazione = [
      {contenuto: 'Ricevimento', classi: 'col-sm-2', scope: 'col'},
      {contenuto: 'Modalità', classi: 'col-sm-2', scope: 'col'}
    ] %}
    {% set righe = [] %}
    {% for r in dati %}
      {% set righe = righe|merge([{celle: [
        {contenuto: '<span class="gs-big">' ~ r.data|format_date('full')|title
          ~ ' dalle ' ~ r.inizio|date('G:i') ~ ' alle ' ~ r.fine|date('G:i') ~ '</span>'},
        {contenuto: '<span class="gs-big">' ~ ('label.tipo_colloquio_' ~ r.tipo)|trans ~ ': '
          ~ r.luogo ~ '</span>'}
      ]}]) %}
    {% endfor %}
    {{ include('include/tabella.html.twig', {
      intestazione: [intestazione], corpo: righe,
      classi: 'table table-bordered table-hover', classe_intestazione: 'bg-info'
    }) }}
  </div>
  {% endif %}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  // Aggiungi opzione vuota alle select se sono vuote
  if ($('#colloqui_cerca_docente option').length === 0) {
    $('#colloqui_cerca_docente').prepend('<option value="">Tutti i docenti</option>');
  }
});
</script>
{% endblock %}

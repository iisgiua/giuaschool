{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-colloqui-cerca">
  <h1 class="text-center gs-h2 gs-mt-2">{{ titolo|trans }}</h1>
  <form name="{{ form[0].vars.name }}" method="{{ form[0].vars.method }}" action="{{ form[0].vars.action }}" class="gs-colloqui-cerca-filters gs-mb-3">
    <div id="{{ form[0].vars.id }}">
      <div class="gs-colloqui-cerca-filters-row">
        <div class="gs-colloqui-cerca-filter-col">
          {{ form_label(form[0].docente) }}
          {{ form_widget(form[0].docente) }}
        </div>
        <div class="gs-colloqui-cerca-filter-col gs-colloqui-cerca-btn">
          {{ form_widget(form[0].submit) }}
        </div>
      </div>
      {% if form[0].data is defined %}
        <div class="gs-colloqui-cerca-filters-row">
          <div class="gs-colloqui-cerca-filter-col">
            {{ form_label(form[0].data) }}
            {{ form_widget(form[0].data) }}
          </div>
        </div>
      {% endif %}
      {{ form_widget(form[0]._token) }}
    </div>
  </form>
  {% if dati|length == 0 %}
  <div class="alert alert-info text-center gs-big">
    <strong>Non sono presenti dati</strong>
  </div>
  {% else %}
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h3 class="panel-title text-center">
        <strong>{{ dati[0].docente.cognome }} {{ dati[0].docente.nome }}</strong>
      </h3>
    </div>
    <table class="table table-bordered table-hover">
      <thead class="bg-info">
        <tr>
          <th class="col-sm-2">Ricevimento</th>
          <th class="col-sm-2">Modalità</th>
        </tr>
      </thead>
      <tbody>
    {% for r in dati %}
        <tr>
          <td class="gs-big">
            {{ r.data|format_date('full')|title }} dalle {{ r.inizio|date('G:i') }} alle {{ r.fine|date('G:i') }}
          </td>
          <td class="gs-big">
            {{ ('label.tipo_colloquio_' ~ r.tipo)|trans }}: {{ r.luogo }}
          </td>
        </tr>
    {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  // Aggiungi opzione vuota alle select se sono vuote
  if ($('#colloqui_cerca_docente option').length === 0) {
    $('#colloqui_cerca_docente').prepend('<option value="">Tutti i docenti</option>');
  }
});
</script>
{% endblock %}

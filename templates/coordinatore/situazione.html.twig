{% extends 'coordinatore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not classe %}
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id|default(0), gruppo: false}, with_context: false) }}
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">{{ 'title.coordinatore_situazione'|trans }} {{ classe }}</h1>
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id, gruppo: false}, with_context: false) }}
  {% set intestazione = [
      {contenuto: 'Alunno', scope: 'col'},
      {contenuto: 'Azioni', classi: 'actions', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
    {% for alunno, a in dati.alunni %}
      <tr>
        <td>
          <strong>{{ a.cognome }} {{ a.nome }}</strong> ({{ a.dataNascita|date('d/m/Y') }})
          {{ include('include/scheda-alunno.html.twig', {id: loop.index, a: a, g: dati.genitori[a.id]}) }}
      {% if a.cambio %}
          <br><em class="text-danger">{{ a.cambio }}</em>
      {% endif %}
      {% if a.frequenzaEstero %}
          <br><em class="text-danger">Frequenta all'estero</em>
      {% endif %}
        </td>
        <td class="actions">
          {{ include('include/pulsanti-azioni-situazione.html.twig', {
            alunno: alunno,
            dettagli_alunno: {cognome: a.cognome, nome: a.nome, data_nascita: a.dataNascita, index: loop.index},
          }) }}
        </td>
      </tr>
    {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
    {% if dati.trasferiti|length > 0 %}
  {% set intestazione = [
      {contenuto: 'Alunno', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Situazione', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Azioni', classi: 'actions', scope: 'col'},
    ] %}
    {% set corpo_grezzo_1 %}
      {% for alunno, a in dati.trasferiti %}
      <tr>
        <td>
          <strong>{{ a.cognome }} {{ a.nome }} ({{ a.dataNascita|date('d/m/Y') }})</strong>
        </td>
        <td>
          <strong class="text-danger">{{ a.cambio }}</strong>
        </td>
        <td class="actions">
          {{ include('include/pulsanti-azioni-situazione.html.twig', {alunno: alunno}) }}
        </td>
      </tr>
      {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_1, classi: 'table table-bordered table-hover table-striped'}) }}
    {% endif %}
    {{ include('include/modal-info.html.twig') }}
  {% endif %}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('[data-toggle="popover"]').popover();
  $('#gs-modal-info').on('show.bs.modal', function (event) {
      var title = $(event.relatedTarget).data('title');
      var id = $(event.relatedTarget).data('body');
      var html = $('#'+id).html();
      $(this).find('#gs-modal-info-label').text(title);
      $(this).find('#gs-modal-info-body').html(html);
  });
  $('#gs-modal-info').on('shown.bs.modal', function (e) {
    $('body').addClass('modal-open');
    $('button.gs-show-hide').on('click', function (e) {
      var el = $(this).parent().siblings('div');
      if (el.is(':visible')) {
        el.fadeOut();
        $(this).attr('title', 'Apre la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-maximize');
      } else {
        el.fadeIn();
        $(this).attr('title', 'Chiude la scheda con le informazioni riservate');
        $(this).find('strong use')
          .attr('href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize')
          .attr('xlink:href', '{{ asset('icons/tabler-sprite.svg') }}#arrows-minimize');
      }
    });
  });
});
</script>
{% endblock %}

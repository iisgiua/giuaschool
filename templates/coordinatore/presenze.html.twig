{% extends 'coordinatore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not info.classe %}
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: info.classe.id|default(0), gruppo: false}, with_context: false) }}
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">{{ titolo|trans({classe: info.classe}) }}</h1>
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: info.classe.id, gruppo: false}, with_context: false) }}
  {{ include('admin/include/flash.html.twig') }}
  {% form_theme form[0] 'bootstrap_3_layout.html.twig' %}
  <form name="{{ form[0].vars.name }}" method="{{ form[0].vars.method }}" action="{{ form[0].vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form[0].vars.id }}">
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col">
          {{ form_label(form[0].alunno, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form[0].alunno) }}
        </div>
      </div>
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col">
          {{ form_label(form[0].inizio, null, {label_attr: {class: 'control-label'}}) }}
          <div class="input-group date">
            {{ form_widget(form[0].inizio, {attr: {widget: false}}) }}
            <span class="input-group-addon" aria-hidden="true">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline'}) }}</span>
          </div>
        </div>
        <div class="form-group gs-filter-col">
          {{ form_label(form[0].fine, null, {label_attr: {class: 'control-label'}}) }}
          <div class="input-group date">
            {{ form_widget(form[0].fine, {attr: {widget: false}}) }}
            <span class="input-group-addon" aria-hidden="true">{{ include('admin/include/icona.html.twig', {nome: 'calendar', stile: 'outline'}) }}</span>
          </div>
        </div>
      </div>
      <div class="gs-filters-buttons">
        {{ form_widget(form[0].submit) }}
      </div>
      {{ form_widget(form[0]._token) }}
    </div>
  </form>
  <div class="row gs-mb-2"> <div class="col-sm-offset-6 col-sm-6 text-right"> <a class="btn btn-primary" href="{{ path('coordinatore_presenze_add', {classe: info.classe.id}) }}" role="button" title="Pianifica nuove presenze fuori classe"><strong>Aggiungi</strong></a> </div> </div>
  {% set intestazione = [
      {contenuto: 'Alunno', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Data', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Attività', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'label.action'|trans, classi: 'col-sm-3', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
    {% for p in dati.lista %}
      <tr>
        <td>{{ p.alunno }}</td>
        <td>{{ p.data|date('d/m/Y') }} {% if p.oraInizio %}dalle {{ p.oraInizio|date('H:i') }}{% if p.oraFine %} alle {{ p.oraFine|date('H:i') }}{% endif %}{% else %}tutto il giorno{% endif %}</td>
        <td><small>{{ ('label.presenza_tipo_' ~ p.tipo)|trans }}: {{ p.descrizione }}</small></td>
        <td>
      {% if p.data > info.oggi %}
          <a class="btn btn-primary btn-xs gs-mr-2" href="{{ path('coordinatore_presenze_edit', {id: p.id, classe: info.classe.id}) }}" role="button" title="Modifica i dati della presenza fuori classe"><strong>{{ 'label.edit'|trans }}</strong></a>
          <button type="button" class="btn btn-danger btn-xs gs-modal-confirm-button" title="Rimuove la presenza fuori classe" data-toggle="modal" data-target="#gs-modal-confirm" data-titolo="{{ p.alunno }}" data-contenuto="{{ 'message.cancella_presenza'|trans }}" data-href="{{ path('coordinatore_presenze_delete', {id: p.id, classe: info.classe.id}) }}" data-csrf="{{ csrf_token('delete') }}"><strong>{{ 'label.delete'|trans }}</strong></button>
      {% endif %}
        </td>
      </tr>
    {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
  {{ include('include/paginate.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'coordinatore_presenze'}) }}
  {{ include('admin/include/modal-confirm.html.twig') }}
  {% endif %}
</div>
{% endblock %}

{% block pagina_css %}
{{ parent() }}
<link href="{{ asset('vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet">
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js') }}"></script>
<script src="{{ asset('vendor/bootstrap-datepicker/locales/bootstrap-datepicker.it.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('.input-group.date').datepicker({
    format: "dd/mm/yyyy",
    weekStart: 1,
    maxViewMode: 1,
    daysOfWeekDisabled: "0",
    startDate: "{{ info.annoInizio }}",
    endDate: "{{ info.annoFine }}",
    todayBtn: "linked",
    todayHighlight: true,
    autoclose: true,
    language: "it",
    zIndexOffset: 1200
  });
  $('#gs-modal-confirm').on('show.bs.modal', function(e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}

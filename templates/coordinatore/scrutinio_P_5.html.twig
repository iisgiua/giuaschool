{% extends 'coordinatore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not classe %}
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id|default(0), gruppo: false}, with_context: false) }}
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-0">{{ 'title.coordinatore_scrutinio'|trans }} {{ classe }}</h1>
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id, gruppo: false}, with_context: false) }}
    {{ include('include/modal-error.html.twig') }}
    {{ form_start(form) }}
  <h2 class="text-center gs-h2 gs-mt-0 gs-mb-3">Passo 5: comunicazioni dei debiti</h2>
  <h3 class="text-center text-info gs-h3 gs-mt-0 gs-mb-3"><em>Clicca sul pulsante di modifica per inserire le comunicazioni, o su una comunicazione compilata per modificarla.</em></h2>
    {% if dati.debiti|length > 0 %}
  <div>
    {% set intestazione = [
      {contenuto: '<small>Alunno</small>', classi: 'col-sm-3 gs-pt-1 gs-pb-1 gs-pl-2 gs-pr-2', scope: 'col'},
      {contenuto: '<small><span data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="Materie con debito formativo">Materie</span></small>', classi: 'col-sm-7 gs-pt-1 gs-pb-1 gs-pl-2 gs-pr-2', scope: 'col'},
      {contenuto: '<small><span data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="Comunicazione dei debiti formativi">Comunicazione</span></small>', classi: 'col-sm-2 gs-pt-1 gs-pb-1 gs-pl-2 gs-pr-2', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
        {% for alunno, a in dati.debiti %}
        <tr>
          {% for materia, m in a %}
            {% if loop.first %}
          <td class="gs-pt-1 gs-pb-1 gs-pl-2 gs-pr-2">
            <strong>{{ m.cognome }} {{ m.nome }}</strong><br><small>({{ m.dataNascita|date('d/m/Y') }})</small>
              {% if m.bes != 'N' %}
            <button type="button" class="btn btn-xs btn-default gs-ml-1" title="Informazioni sull'alunno" data-placement="auto left" data-toggle="popover" data-trigger="hover" data-content="{{ ('label.bes_' ~ m.bes)|trans }}">{{ include('admin/include/icona.html.twig', {nome: 'info-circle', stile: 'outline'}) }}</button>
              {% endif %}
          </td>
          <td>
            {% endif %}
            <strong>{{ m.materia }}{{ not loop.last ? ', ' }}</strong>
            {% if loop.last %}
          </td>
          <td>
              {% if dati.esiti[alunno].debiti is defined and dati.esiti[alunno].debiti %}
            {{ include('include/bottone-azione.html.twig', {nome: 'check', etichetta: 'Modifica', titolo: 'Modifica la comunicazione dei debiti formativi', stile: 'success', dimensione: '', classi: 'gs-button-remote gs-ml-4', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote', 'data-href': path('coordinatore_scrutinio_debiti', {alunno: alunno, periodo: periodo})}}) }}
              {% else %}
            {{ include('include/bottone-azione.html.twig', {nome: 'pencil', etichetta: 'Compila la comunicazione dei debiti formativi', titolo: 'Compila la comunicazione dei debiti formativi', classi: 'gs-button-remote gs-ml-4', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote', 'data-href': path('coordinatore_scrutinio_debiti', {alunno: alunno, periodo: periodo})}}) }}
              {% endif %}
          </td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
  </div>
    {% else %}
  <div class="alert alert-success gs-mb-3" role="alert">
    <strong>Non sono presenti debiti formativi</strong>
  </div>
    {% endif %}
  <div class="row gs-mt-5 gs-mb-5 gs-riga-passi">
    <div class="col-sm-6">
      <a class="btn btn-primary gs-wait-page" href="{{ path('coordinatore_scrutinio', {classe: classe.id, stato: '4'}) }}" role="button" title="Annulla e torna al passo precedente">{{ include('admin/include/icona.html.twig', {nome: 'arrow-left', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Torna al passo precedente</strong></a>
    </div>
    <div class="text-right col-sm-6">
      <button class="btn btn-primary" title="Vai al passo successivo" data-toggle="modal" data-target="#gs-modal-waiting">{{ include('admin/include/icona.html.twig', {nome: 'arrow-right', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Conferma e vai avanti</strong></button>
    </div>
  </div>
    {{ form_end(form) }}
    {{ include('include/modal-remote.html.twig') }}
    {{ include('include/modal-waiting.html.twig') }}
  {% endif %}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/floatThead/jquery.floatThead.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('[data-toggle="popover"]').popover({container: 'body'});
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href')+'/'+Math.floor($('html').scrollTop());
    $(this).find('#gs-modal-remote-content').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
  $('#gs-modal-waiting').on('shown.bs.modal', function (event) {
    $('form[name="scrutinio"]').submit();
  });
  $('a.gs-wait-page').click(function (event) {
    $('#gs-modal-waiting').modal('show');
    return true;
  });
  // init
  $('#gs-fixed-header table').floatThead({
    top: 60,
    responsiveContainer: function($table) {
      return $table.closest('.table-responsive');
    }
  });
  {% if posizione > 0 %}
  $('html').scrollTop({{ posizione }});
  {% endif %}
  {% for messaggio in app.flashes('errore') %}
    {% if loop.first %}
  var m = '';
    {% endif %}
  m = m + "{{ messaggio|raw }}<br>";
    {% if loop.last %}
  $('#gs-modal-error-text').html(m);
  $('#gs-modal-error').modal('show');
    {% endif %}
  {% endfor %}
});
</script>
{% endblock %}

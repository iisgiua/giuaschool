{% extends 'coordinatore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if not classe %}
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id|default(0), gruppo: false}, with_context: false) }}
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">{{ 'title.coordinatore_note'|trans }} {{ classe }}</h1>
  {# selettore sede/classe #}
  {{ include('include/selettore-classe.html.twig', {classi: gs_classi_coordinatore(), azione: 'coordinatore_seleziona', attiva: classe.id, gruppo: false}, with_context: false) }}
    {% for periodo, v in dati %}
  <div class="gs-periodo-testa gs-mt-4 gs-mb-2">
    <div class="gs-periodo-titolo text-info">
      <strong class="gs-big">{{ periodo }}</strong>
    </div>
    <div class="gs-periodo-azioni">
      <a class="btn btn-success btn-sm" href="{{ path('coordinatore_note', {classe: classe.id, tipo: 'P'}) }}" role="button" title="Scarica il documento in formato PDF">{{ include('admin/include/icona.html.twig', {nome: 'printer', stile: 'outline', classe: 'gs-mr-3'}) }}<strong>{{ 'label.stampa'|trans }}</strong></a>
    </div>
  </div>
  {% set intestazione = [
      {contenuto: 'Data', classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'Destinatari', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Nota', classi: 'col-sm-5', scope: 'col'},
      {contenuto: 'Provvedimento', classi: 'col-sm-3', scope: 'col'},
    ] %}
    {% set righe = [] %}
    {% for data, v1 in v %}
      {% for tipo, v2 in v1 %}
        {% for k, e in v2 %}
          {# destinatari: cambia a seconda che sia la classe o un gruppo di alunni #}
          {% if tipo == 'classe' %}
            {% set destinatari %}
              <em>Tutta la classe</em>
              {%- if e.esclusi|length > 0 %} <br><strong>Esclusi:</strong> {% for a in e.esclusi %}{{ a }}{{ not loop.last ? ', ' }}{% endfor %}{% endif -%}
            {% endset %}
          {% else %}
            {% set destinatari %}{% for alu in e.alunni %}{{ alu }}{{ not loop.last ? ',<br>' }}{% endfor %}{% endset %}
          {% endif %}
          {% set righe = righe|merge([{celle: [
            {contenuto: '<strong>' ~ e.data ~ '</strong>'},
            {contenuto: destinatari},
            {contenuto: '<small>' ~ e.nota|raw|nl2br ~ '<br><em>(' ~ e.nota_doc|e ~ ')</em></small>'},
            {contenuto: '<small>' ~ (e.provvedimento|raw|nl2br ? (e.provvedimento ~ '<br><em>(' ~ e.provvedimento_doc|e ~ ')</em>')|raw) ~ '</small>'},
          ]}]) %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
    {{ include('include/tabella.html.twig', {
      intestazione: [intestazione], corpo: righe,
    }) }}
    {% else %}
  <div class="alert alert-info" role="alert">
    <strong class="gs-big">Non sono presenti note disciplinari</strong>
  </div>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}

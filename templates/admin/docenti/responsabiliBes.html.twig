{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('docenti_responsabiliBes_edit', {id: 0}), etichetta: 'label.add'|trans, titolo: 'Aggiungi un nuovo responsabile BES'}]}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.cognome'|trans, chiave: 'cognome'},
    {titolo: 'label.nome'|trans, chiave: 'nome'},
    {titolo: 'label.username'|trans, chiave: 'username', classe: 'd-none d-md-table-cell', classe_cella: 'd-none d-md-table-cell'},
    {titolo: 'label.sede'|trans, chiave: 'sede', classe: 'd-none d-lg-table-cell', classe_cella: 'd-none d-lg-table-cell'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for u in dati.lista %}
    {% set righe = righe|merge([{
      cognome: u.cognome,
      nome: u.nome,
      username: u.username,
      sede: u.responsabileBesSede ? u.responsabileBesSede.citta : 'Tutte'
    }]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del responsabile BES',
        url: path('docenti_responsabiliBes_edit', {id: u.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Elimina il responabile BES',
        titolo_modale: u.cognome ~ ' ' ~ u.nome, contenuto: 'message.cancella_responsabileBes'|trans,
        url: path('docenti_responsabiliBes_delete', {id: u.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun responsabile BES trovato',
    azioni: azioni
      }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'docenti_responsabiliBes'}) }}
{% endblock %}

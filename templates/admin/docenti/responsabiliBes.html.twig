{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set rows = [] %}
  {% for u in dati.lista %}
    {% set rows = rows|merge([{
      cells: [
        {content: '<small>' ~ u.cognome ~ '</small>'},
        {content: '<small>' ~ u.nome ~ '</small>'},
        {content: '<small>' ~ u.username ~ '</small>', class: 'd-none d-md-table-cell'},
        {content: '<small>' ~ (u.responsabileBesSede ? u.responsabileBesSede.citta : 'Tutte') ~ '</small>', class: 'd-none d-lg-table-cell'},
        {content: [
          '<a class="btn btn-primary btn-xs mr-1 mb-1" href="' ~ path('docenti_responsabiliBes_edit', {id: u.id}) ~ '" role="button" title="Modifica i dati del responsabile BES"><i class="fas fa-edit"></i></a>',
          '<a class="btn btn-danger btn-xs mr-1 mb-1" href="' ~ path('docenti_responsabiliBes_delete', {id: u.id}) ~ '" role="button" title="Elimina il responabile BES"><i class="fas fa-trash"></i></a>'
        ], class: 'pb-0'}
      ]
    }]) %}
  {% endfor %}
  {% include 'admin/include/table-responsive.html.twig' with {
    headers: [
      {label: 'label.cognome'|trans},
      {label: 'label.nome'|trans},
      {label: 'label.username'|trans, hidden_class: 'd-none d-md-table-cell'},
      {label: 'label.sede'|trans, hidden_class: 'd-none d-lg-table-cell'},
      {label: 'label.action'|trans}
    ],
    rows: rows,
    empty_message: 'Nessun responsabile BES trovato'
  } %}
  <div class="text-center mt-3">
    <a class="btn btn-primary btn-sm" href="{{ path('docenti_responsabiliBes_edit', {id: 0}) }}" role="button" title="Aggiungi un nuovo responsabile BES">{{ 'label.add'|trans }}</a>
  </div>
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('docenti_responsabiliBes') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}

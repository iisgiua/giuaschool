{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  {# pulsanti di pagina sotto il titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('docenti_staff_edit', {id: 0}), etichetta: 'label.add'|trans, titolo: 'Aggiungi un nuovo docente allo staff'}]}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.cognome'|trans, chiave: 'cognome'},
    {titolo: 'label.nome'|trans, chiave: 'nome'},
    {titolo: 'label.username'|trans, chiave: 'username', classe: 'd-none d-md-table-cell', classe_cella: 'd-none d-md-table-cell'},
    {titolo: 'label.sede'|trans, chiave: 'sede', classe: 'd-none d-lg-table-cell', classe_cella: 'd-none d-lg-table-cell'},
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for u in dati.lista %}
    {% set righe = righe|merge([{
      cognome: u.cognome,
      nome: u.nome,
      username: u.username,
      sede: u.sede ? u.sede.citta : 'Tutte',
    }]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del componente dello staff',
        url: path('docenti_staff_edit', {id: u.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Elimina il componente dello staff',
        titolo_modale: u.cognome ~ ' ' ~ u.nome, contenuto: 'message.cancella_staff'|trans,
        url: path('docenti_staff_delete', {id: u.id})},
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun componente dello staff trovato',
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_staff'},
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'docenti_staff'}) }}
{% endblock %}

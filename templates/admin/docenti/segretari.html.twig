{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  {# pulsanti di pagina sotto il titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('docenti_segretari_edit', {id: 0}), etichetta: 'label.add'|trans, titolo: 'Aggiungi un nuovo segretario'}]}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.cognome'|trans, chiave: 'cognome'},
    {titolo: 'label.nome'|trans, chiave: 'nome'},
    {titolo: 'label.username'|trans, chiave: 'username', classe: 'd-none d-md-table-cell', classe_cella: 'd-none d-md-table-cell'},
    {titolo: 'label.sede'|trans, chiave: 'sede', classe: 'd-none d-lg-table-cell', classe_cella: 'd-none d-lg-table-cell'},
    {titolo: 'label.classe'|trans, chiave: 'classe', classe: 'd-none d-xl-table-cell', classe_cella: 'd-none d-xl-table-cell'},
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for c in dati.lista %}
    {% set righe = righe|merge([{
      cognome: c.segretario.cognome,
      nome: c.segretario.nome,
      username: c.segretario.username,
      sede: c.sede.nomeBreve,
      classe: c,
    }]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del segretario',
        url: path('docenti_segretari_edit', {id: c.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Elimina il segretario',
        titolo_modale: c.segretario.cognome ~ ' ' ~ c.segretario.nome,
        contenuto: 'message.cancella_segretario'|trans, url: path('docenti_segretari_delete', {id: c.id})},
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun segretario trovato',
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_segretari'},
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'docenti_segretari'}) }}
{% endblock %}

{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('docenti_rappresentanti_edit', {id: 0}), etichetta: 'label.add'|trans, titolo: 'Aggiungi un nuovo rappresentante'}]}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.rappresentante'|trans, chiave: 'rappresentante'},
    {titolo: 'label.tipo'|trans, chiave: 'tipo'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for u in dati.lista %}
    {% set tipi = [] %}
    {% for r in u.rappresentante %}
      {% set tipi = tipi|merge([('label.rappresentante_' ~ r)|trans]) %}
    {% endfor %}
    {% set righe = righe|merge([{rappresentante: u, tipo: tipi|join(', ')}]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del rappresentante',
        url: path('docenti_rappresentanti_edit', {id: u.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Elimina il rappresentante',
        titolo_modale: u, contenuto: 'message.cancella_rappresentante_docenti'|trans,
        url: path('docenti_rappresentanti_delete', {id: u.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun rappresentante trovato',
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_rappresentanti'}
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'docenti_rappresentanti'}) }}
{% endblock %}

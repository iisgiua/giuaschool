{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid" style="padding-top: 1rem;">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set rows = [] %}
  {% for a in dati.lista %}
    {% set stato_icon = a.abilitato ? '<span title="' ~ 'label.utente_attivo'|trans ~ '"><svg class="icon icon-xs icon-success" aria-hidden="true"><use xlink:href="' ~ asset('vendor/fontawesome/sprites/solid.svg') ~ '#check"></use></svg></span>' : '<span title="' ~ 'label.utente_disabilitato'|trans ~ '"><svg class="icon icon-sm icon-danger" aria-hidden="true"><use xlink:href="' ~ asset('vendor/fontawesome/sprites/solid.svg') ~ '#ban"></use></svg></span>' %}
    {% set buttons = [
      '<button type="button" class="btn btn-primary btn-xs mr-1 mb-1" data-toggle="modal" data-target="#gs-info-' ~ a.id ~ '">' ~ 'label.show'|trans ~ '</button>',
      '<a class="btn btn-primary btn-xs mr-1 mb-1" href="' ~ path('alunni_modifica_edit', {id: a.id}) ~ '" role="button" title="Modifica i dati dell\'utente">' ~ 'label.edit'|trans ~ '</a>',
      '<a class="btn btn-primary btn-xs mr-1 mb-1" href="' ~ path('alunni_password', {username: a.username, tipo: 'E'}) ~ '" role="button" title="Genera una nuova password per l\'alunno e la invia tramite email">' ~ 'label.email_password'|trans ~ '</a>',
      '<a class="btn btn-primary btn-xs mr-1 mb-1" href="' ~ path('alunni_password', {username: a.username, tipo: 'P'}) ~ '" role="button" title="Genera una nuova password per l\'alunno e la scarica come documento PDF">' ~ 'label.pdf_password'|trans ~ '</a>'
    ] %}
    {% if a.abilitato %}
      {% set buttons = buttons|merge(['<a class="btn btn-danger btn-xs mb-1" href="' ~ path('alunni_abilita', {id: a.id, abilita: 0}) ~ '" role="button" title="Disabilita l\'utente">' ~ 'label.disable'|trans ~ '</a>']) %}
    {% else %}
      {% set buttons = buttons|merge(['<a class="btn btn-success btn-xs mb-1" href="' ~ path('alunni_abilita', {id: a.id, abilita: 1}) ~ '" role="button" title="Abilita l\'utente">' ~ 'label.enable'|trans ~ '</a>']) %}
    {% endif %}
    {% set buttons = buttons|merge([
      '<button type="button" class="btn btn-secondary btn-xs mr-1 mb-1" data-toggle="modal" data-target="#gs-scelta-genitore" title="Genera una nuova password per il genitore e la invia tramite email" data-title="Scegli il genitore a cui inviare la password" data-button1="' ~ ((dati.genitori[a.id][0].email and dati.genitori[a.id][0].email[-6:] != '.local') ? 'Invia') ~ '" data-gen1="' ~ dati.genitori[a.id][0].nome ~ ' ' ~ dati.genitori[a.id][0].cognome ~ ' (' ~ dati.genitori[a.id][0].username ~ ')" data-email1="' ~ ((dati.genitori[a.id][0].email and dati.genitori[a.id][0].email[-6:] != '.local') ? (': ' ~ dati.genitori[a.id][0].email) : '') ~ '" data-href1="' ~ (dati.genitori[a.id][0].username ? path('alunni_password', {username: dati.genitori[a.id][0].username, tipo: 'E'}) : '#') ~ '" data-button2="' ~ ((dati.genitori[a.id][1].email and dati.genitori[a.id][1].email[-6:] != '.local') ? 'Invia') ~ '" data-gen2="' ~ dati.genitori[a.id][1].nome ~ ' ' ~ dati.genitori[a.id][1].cognome ~ ' (' ~ dati.genitori[a.id][1].username ~ ')" data-email2="' ~ ((dati.genitori[a.id][1].email and dati.genitori[a.id][1].email[-6:] != '.local') ? (': ' ~ dati.genitori[a.id][1].email) : '') ~ '" data-href2="' ~ (dati.genitori[a.id][1].username ? path('alunni_password', {username: dati.genitori[a.id][1].username, tipo: 'E'}) : '#') ~ '">' ~ 'label.email_password_genitore'|trans ~ '</button>',
      '<button type="button" class="btn btn-secondary btn-xs mr-1 mb-1" data-toggle="modal" data-target="#gs-scelta-genitore" title="Genera una nuova password per il genitore e la scarica come documento PDF" data-title="Scegli il genitore di cui scaricare la password" data-button1="Scarica" data-gen1="' ~ dati.genitori[a.id][0].nome ~ ' ' ~ dati.genitori[a.id][0].cognome ~ ' (' ~ dati.genitori[a.id][0].username ~ ')" data-email1="" data-href1="' ~ (dati.genitori[a.id][0].username ? path('alunni_password', {username: dati.genitori[a.id][0].username, tipo: 'P'}) : '#') ~ '" data-button2="Scarica" data-gen2="' ~ dati.genitori[a.id][1].nome ~ ' ' ~ dati.genitori[a.id][1].cognome ~ ' (' ~ dati.genitori[a.id][1].username ~ ')" data-email2="" data-href2="' ~ (dati.genitori[a.id][1].username ? path('alunni_password', {username: dati.genitori[a.id][1].username, tipo: 'P'}) : '#') ~ '">' ~ 'label.pdf_password_genitore'|trans ~ '</button>'
    ]) %}
    {% set rows = rows|merge([{
      row_class: not a.abilitato ? 'table-danger' : '',
      cells: [
        {content: stato_icon},
        {content: '<small>' ~ a.cognome ~ '</small>'},
        {content: '<small>' ~ a.nome ~ '</small>'},
        {content: '<small>' ~ a.dataNascita|date('d/m/Y') ~ '</small>', class: 'd-none d-md-table-cell'},
        {content: '<small>' ~ ('label.bes_' ~ a.bes)|trans ~ '</small>', class: 'd-none d-lg-table-cell'},
        {content: '<small>' ~ a.classe ~ '</small>', class: 'd-none d-xl-table-cell'},
        {content: buttons, class: 'pb-0'}
      ]
    }]) %}
  {% endfor %}
  {% include 'admin/include/table-responsive.html.twig' with {
    headers: [
      {label: 'label.stato'|trans},
      {label: 'label.cognome'|trans},
      {label: 'label.nome'|trans},
      {label: 'label.data_nascita'|trans, hidden_class: 'd-none d-md-table-cell'},
      {label: 'label.bes'|trans, hidden_class: 'd-none d-lg-table-cell'},
      {label: 'label.classe'|trans, hidden_class: 'd-none d-xl-table-cell'},
      {label: 'label.action'|trans}
    ],
    rows: rows,
    empty_message: 'Nessun alunno trovato'
  } %}
  <div class="text-center mt-3">
    <a class="btn btn-primary btn-sm" href="{{ path('alunni_modifica_edit') }}" role="button" title="Nuovo utente">{{ 'label.add'|trans }}</a>
    <a class="btn btn-primary btn-sm" href="{{ path('alunni_passwordFiltro', {genitore: 0}) }}" role="button" title="Genera le nuove password per gli alunni selezionati e le scarica come documento PDF">{{ 'label.pdf_password'|trans }}</a>
    <a class="btn btn-primary btn-sm" href="{{ path('alunni_passwordFiltro', {genitore: 1}) }}" role="button" title="Genera le nuove password per i genitori degli alunni selezionati e le scarica come documento PDF">{{ 'label.pdf_password_genitore'|trans }}</a>
  </div>
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
<script>
$(document).ready(function() {
  $('#gs-scelta-genitore').on('show.bs.modal', function (e) {
    var title = $(e.relatedTarget).data('title');
    var button1 = $(e.relatedTarget).data('button1');
    var gen1 = $(e.relatedTarget).data('gen1');
    var email1 = $(e.relatedTarget).data('email1');
    var href1 = $(e.relatedTarget).data('href1');
    var button2 = $(e.relatedTarget).data('button2');
    var gen2 = $(e.relatedTarget).data('gen2');
    var email2 = $(e.relatedTarget).data('email2');
    var href2 = $(e.relatedTarget).data('href2');
    $(this).find('#gs-scelta-genitore-titolo').text(title);
    if (button1) {
      $('#gs-scelta-genitore-1-href').show();
      $('#gs-scelta-genitore-1-href strong').text(button1);
    } else {
      $('#gs-scelta-genitore-1-href').hide();
    }
    if (button2) {
      $('#gs-scelta-genitore-2-href').show();
      $('#gs-scelta-genitore-2-href strong').text(button2);
    } else {
      $('#gs-scelta-genitore-2-href').hide();
    }
    $(this).find('#gs-scelta-genitore-1').text(gen1);
    $(this).find('#gs-scelta-genitore-1-email').text(email1);
    $(this).find('#gs-scelta-genitore-1-href').attr('href', href1);
    $(this).find('#gs-scelta-genitore-2').text(gen2);
    $(this).find('#gs-scelta-genitore-2-email').text(email2);
    $(this).find('#gs-scelta-genitore-2-href').attr('href', href2);
  });
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('alunni_modifica') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}

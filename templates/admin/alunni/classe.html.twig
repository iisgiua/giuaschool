{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti dei cambiamenti di classe: servono al titolo, quindi definiti qui #}
  {% set pulsanti = [
    {url: path('alunni_classe_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo cambio classe di un alunno',
      classe: 'btn btn-primary btn-sm mr-1 mb-1'},
    {url: path('alunni_classe_edit', {id: 0, tipo: 'I'}), etichetta: 'label.alunno_inserito'|trans,
      titolo: 'Nuovo inserimento di un alunno', classe: 'btn btn-primary btn-sm mr-1 mb-1'},
    {url: path('alunni_classe_edit', {id: 0, tipo: 'T'}), etichetta: 'label.alunno_trasferito'|trans,
      titolo: 'Nuovo trasferimento di un alunno', classe: 'btn btn-primary btn-sm mr-1 mb-1'},
    {url: path('alunni_classe_edit', {id: 0, tipo: 'S'}), etichetta: 'label.alunno_cambio_sezione'|trans,
      titolo: 'Nuovo cambio di sezione di un alunno', classe: 'btn btn-primary btn-sm mr-1 mb-1'}
  ] %}
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: pulsanti}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.alunno'|trans, chiave: 'alunno'},
    {titolo: 'label.classe'|trans, chiave: 'classe'},
    {titolo: 'label.data_inizio'|trans, chiave: 'data_inizio'},
    {titolo: 'label.data_fine'|trans, chiave: 'data_fine'},
    {titolo: 'label.note'|trans, chiave: 'note'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for c in dati.lista %}
    {% set righe = righe|merge([{
      alunno: c.cognome ~ ' ' ~ c.nome ~ ' (' ~ c.dataNascita|date('d/m/Y') ~ ')',
      classe: c.anno ? c.anno ~ 'ª ' ~ c.sezione ~ (c.gruppo ? ('-' ~ c.gruppo) : ''),
      data_inizio: c.cambio.inizio|date('d/m/Y'),
      data_fine: c.cambio.fine|date('d/m/Y'),
      note: c.cambio.note
    }]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del cambio classe',
        url: path('alunni_classe_edit', {id: c.cambio.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella i dati del cambio classe',
        titolo_modale: c.cognome ~ ' ' ~ c.nome, contenuto: 'message.cancella_cambio_classe'|trans,
        url: path('alunni_classe_delete', {id: c.cambio.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun cambio classe trovato',
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'alunni_classe'}
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'alunni_classe'}) }}
{% endblock %}

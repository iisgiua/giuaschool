{##
  # titolo-bottoni: intestazione di una pagina di elenco, con i pulsanti di pagina
  # in alto a destra del titolo e la tabella subito sotto.
  #
  # Uso:
  #   {{ include('admin/include/titolo-bottoni.html.twig', {
  #     titolo: titolo|trans,
  #     bottoni: [{url: path('...'), etichetta: 'label.add'|trans, titolo: 'Nuovo ...',
  #                classe: 'btn btn-primary btn-sm'}]
  #   }) }}
  #
  # bottoni: elenco di {url, etichetta, titolo, classe}. Se omesso, resta solo il titolo.
  # I pulsanti stanno SEMPRE qui, in testata: non sotto la tabella e non in un tfoot,
  # dove finivano nascosti dal bordo inferiore.
  # #}

{% set bottoni = bottoni|default([]) %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0 flex-grow-1 text-center">{{ titolo }}</h1>
  {% if bottoni is not empty %}
  <div class="gs-azioni flex-shrink-0">
    {% for bottone in bottoni %}
      {# NOSONAR Web:S6819 - role="button" richiesto dall'a11y su un <a> con classe .btn #}
      <a class="{{ bottone.classe|default('btn btn-primary btn-sm') }}" href="{{ bottone.url }}" role="button"
        title="{{ bottone.titolo|default('') }}">{{ bottone.etichetta|default('label.add'|trans) }}</a>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('ata_modifica_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo utente'}]}) }}
  {{ include('admin/include/filtro.html.twig', {form: form[0]}) }}
  {% set colonne = [
    {titolo: 'label.stato'|trans, chiave: 'abilitato', tipo: 'stato',
      titolo_vero: 'label.utente_attivo'|trans, titolo_falso: 'label.utente_disabilitato'|trans},
    {titolo: 'label.cognome'|trans, chiave: 'cognome'},
    {titolo: 'label.nome'|trans, chiave: 'nome'},
    {titolo: 'label.username'|trans, chiave: 'username'},
    {titolo: 'label.sede'|trans, chiave: 'sede'},
    {titolo: 'label.mansioni'|trans, chiave: 'mansioni'}
  ] %}
  {% set azioni = [] %}
  {% for u in dati.lista %}
    {% set voci = [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo_modale: u.cognome ~ ' ' ~ u.nome,
        contenuto: t.info([
          {etichetta: 'label.nome'|trans, valore: u.nome},
          {etichetta: 'label.cognome'|trans, valore: u.cognome},
          {etichetta: 'label.sesso'|trans, valore: (u.sesso == 'M' ? 'label.maschile' : 'label.femminile')|trans},
          {etichetta: 'label.codice_fiscale'|trans, valore: u.codiceFiscale},
          {etichetta: 'label.ata_tipo'|trans, valore: ('label.ata_tipo_' ~ u.tipo)|trans},
          {etichetta: 'label.ata_segreteria'|trans, valore: (u.segreteria ? 'label.si' : 'label.no')|trans},
          {etichetta: 'label.sede'|trans, valore: u.sede},
          {etichetta: 'label.spid'|trans, valore: (u.spid ? 'Si' : 'No')},
          {etichetta: 'label.username'|trans, valore: u.username},
          {etichetta: 'label.email'|trans, valore: u.email},
          {etichetta: 'label.ultimo_accesso'|trans, valore: u.ultimoAccesso ? u.ultimoAccesso|date('d/m/Y H:i:s') : '', vuoto: 'NESSUNO'}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: "Modifica i dati dell'utente",
        url: path('ata_modifica_edit', {id: u.id})},
      {tipo: 'link', etichetta: 'label.email_password'|trans, titolo: "Genera una nuova password e la invia all'utente tramite email",
        url: path('ata_password', {id: u.id, tipo: 'E'})},
      {tipo: 'link', etichetta: 'label.pdf_password'|trans, titolo: 'Genera una nuova password e la scarica come documento PDF',
        url: path('ata_password', {id: u.id, tipo: 'P'})}
    ] %}
    {% if u.abilitato %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'danger', etichetta: 'label.disable'|trans,
        titolo: "Disabilita l'utente", titolo_modale: u.cognome ~ ' ' ~ u.nome,
        contenuto: 'message.disabilita_ata'|trans, url: path('ata_abilita', {id: u.id, abilita: 0})}]) %}
    {% else %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'success', etichetta: 'label.enable'|trans,
        titolo: "Abilita l'utente", titolo_modale: u.cognome ~ ' ' ~ u.nome,
        contenuto: 'message.abilita_ata'|trans, url: path('ata_abilita', {id: u.id, abilita: 1})}]) %}
    {% endif %}
    {% set azioni = azioni|merge([{voci: voci}]) %}
  {% endfor %}
  {{ t.tabella(colonne, dati.lista, {
    vuoto: 'Nessun utente ATA trovato',
    mappa: {chiave: 'abilitato', valori: {1: '', 0: 'table-danger'}},
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'ata_modifica'}
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig', {url_paginazione: 'ata_modifica'}) }}
{% endblock %}

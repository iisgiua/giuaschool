{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_sedi_edit'), etichetta: 'label.add'|trans, titolo: 'Nuova sede'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.nome_sede'|trans, chiave: 'nome'},
    {titolo: 'label.citta'|trans, chiave: 'citta'},
    {titolo: 'label.indirizzo'|trans, chiave: 'indirizzo'}
  ] %}
  {% set azioni = [] %}
  {% for s in dati %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: 'Mostra i dettagli della sede', titolo_modale: s.nome,
        contenuto: t.info([
          {etichetta: 'label.nome_sede'|trans, valore: s.nome},
          {etichetta: 'label.nome_breve_sede'|trans, valore: s.nomeBreve},
          {etichetta: 'label.citta'|trans, valore: s.citta},
          {etichetta: 'label.indirizzo'|trans, valore: s.indirizzo1},
          {etichetta: 'label.indirizzo_cap'|trans, valore: s.indirizzo2},
          {etichetta: 'label.telefono'|trans, valore: s.telefono},
          {etichetta: 'label.ordinamento'|trans, valore: s.ordinamento}
        ], 'row', 'col-sm-3 text-right', 'col-sm-9')},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati della sede',
        url: path('scuola_sedi_edit', {id: s.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella la sede', titolo_modale: s.nome,
        contenuto: 'message.cancella_sede'|trans, url: path('scuola_sedi_delete', {id: s.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, dati, {
    vuoto: 'Nessuna sede trovata',
    azioni: azioni
      }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

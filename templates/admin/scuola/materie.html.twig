{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_materie_edit'), etichetta: 'label.add'|trans, titolo: 'Nuova materia'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.nome_materia'|trans, chiave: 'nome'},
    {titolo: 'label.tipo'|trans, chiave: 'tipo'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for m in dati %}
    {% set righe = righe|merge([{nome: m.nome, tipo: ('label.tipo_materia_' ~ m.tipo)|trans}]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: 'Mostra i dettagli della materia', titolo_modale: m.nome,
        contenuto: t.info([
          {etichetta: 'label.nome_materia'|trans, valore: m.nome, classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'},
          {etichetta: 'label.nome_breve_materia'|trans, valore: m.nomeBreve, classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'},
          {etichetta: 'label.tipo_materia'|trans, valore: ('label.tipo_materia_' ~ m.tipo)|trans,
            classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-3'},
          {etichetta: 'label.valutazione_materia'|trans, valore: ('label.valutazione_materia_' ~ m.valutazione)|trans,
            classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-3'},
          {etichetta: 'label.media_materia'|trans, valore: (m.media ? 'label.si' : 'label.no')|trans,
            classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-3'},
          {etichetta: 'label.ordinamento'|trans, valore: m.ordinamento, classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-3'}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati della materia',
        url: path('scuola_materie_edit', {id: m.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella la materia', titolo_modale: m.nome,
        contenuto: 'message.cancella_materia'|trans, url: path('scuola_materie_delete', {id: m.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessuna materia trovata',
    azioni: azioni
      }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

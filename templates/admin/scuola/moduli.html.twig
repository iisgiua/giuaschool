{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsante di pagina sotto il titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans,
    bottoni: [{url: path('scuola_moduli_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo modulo'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.stato'|trans, chiave: 'abilitata', tipo: 'stato',
      titolo_vero: 'label.stato_abilitato'|trans, titolo_falso: 'label.stato_disabilitato'|trans},
    {titolo: 'label.nome_modulo'|trans, chiave: 'nome'},
    {titolo: 'label.sede'|trans, chiave: 'sede', vuoto: 'TUTTE'},
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for m in dati %}
    {% set righe = righe|merge([{
      abilitata: m.abilitata,
      nome: m.nome,
      sede: m.sede ? m.sede.nomeBreve : '',
    }]) %}
    {% set voci = [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del modulo',
        url: path('scuola_moduli_edit', {id: m.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella il modulo', titolo_modale: m.nome,
        contenuto: 'message.cancella_modulo'|trans, url: path('scuola_moduli_delete', {id: m.id})},
    ] %}
    {% if m.abilitata %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'danger', etichetta: 'label.disable'|trans, titolo: 'Disabilita il modulo di richesta',
        titolo_modale: m.nome, contenuto: 'message.disabilita_modulo'|trans,
        url: path('scuola_moduli_abilita', {id: m.id, abilita: 0})}]) %}
    {% else %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'success', etichetta: 'label.enable'|trans, titolo: 'Abilita il modulo di richiesta',
        titolo_modale: m.nome, contenuto: 'message.abilita_modulo'|trans,
        url: path('scuola_moduli_abilita', {id: m.id, abilita: 1})}]) %}
    {% endif %}
    {% set azioni = azioni|merge([{voci: voci}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun modulo trovato',
    mappa: {chiave: 'abilitata', valori: {1: '', 0: 'table-danger'}},
    azioni: azioni,
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

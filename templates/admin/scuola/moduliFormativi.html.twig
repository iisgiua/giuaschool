{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_moduliFormativi_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo modulo formativo'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.nome'|trans, chiave: 'nome_breve'},
    {titolo: 'label.tipo'|trans, chiave: 'tipo'},
    {titolo: 'label.classi'|trans, chiave: 'classi'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for m in dati %}
    {% set classi = [] %}
    {% for c in m.classi %}
      {% set classi = classi|merge([('label.classi_' ~ c)|trans]) %}
    {% endfor %}
    {% set righe = righe|merge([{
      nome_breve: m.nomeBreve,
      tipo: ('label.modulo_formativo_tipo_' ~ m.tipo)|trans,
      classi: classi|join(', ')
    }]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: 'Mostra i dettagli del modulo formativo', titolo_modale: m.nome,
        contenuto: t.info([
          {etichetta: 'label.nome'|trans, valore: m.nome, classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'},
          {etichetta: 'label.nome_breve'|trans, valore: m.nomeBreve, classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'},
          {etichetta: 'label.tipo'|trans, valore: ('label.modulo_formativo_tipo_' ~ m.tipo)|trans,
            classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'},
          {etichetta: 'label.classi'|trans, valore: classi|join(', '), classi_etichetta: 'col-sm-3 text-right', classi_valore: 'col-sm-9'}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del modulo formativo',
        url: path('scuola_moduliFormativi_edit', {id: m.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella il modulo formativo', titolo_modale: m.nome,
        contenuto: 'message.cancella_moduloFormativo'|trans, url: path('scuola_moduliFormativi_delete', {id: m.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun modulo formativo trovato',
    azioni: azioni
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_classi_edit'), etichetta: 'label.add'|trans, titolo: 'Nuova classe'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.classe'|trans, chiave: 'classe'},
    {titolo: 'label.corso'|trans, chiave: 'corso'},
    {titolo: 'label.sede'|trans, chiave: 'sede'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for c in dati.lista %}
    {% set nome_classe = c.anno ~ 'ª ' ~ c.sezione ~ (c.gruppo ? ('-' ~ c.gruppo) : '') %}
    {% set righe = righe|merge([{classe: c, corso: c.corso.nomeBreve, sede: c.sede.nomeBreve}]) %}
    {% set voci = [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: 'Mostra i dettagli della classe',
        titolo_modale: nome_classe ~ ' - ' ~ c.sede.nomeBreve,
        contenuto: t.info([
          {etichetta: 'label.classe_anno'|trans, valore: c.anno},
          {etichetta: 'label.classe_sezione'|trans, valore: c.sezione},
          {etichetta: 'label.classe_gruppo'|trans, valore: c.gruppo},
          {etichetta: 'label.ore_classe'|trans, valore: c.oreSettimanali},
          {etichetta: 'label.corso'|trans, valore: c.corso.nome},
          {etichetta: 'label.sede'|trans, valore: c.sede.nome},
          {etichetta: 'label.coordinatore'|trans, valore: c.coordinatore ? c.coordinatore.nome ~ ' ' ~ c.coordinatore.cognome : ''},
          {etichetta: 'label.segretario'|trans, valore: c.segretario ? c.segretario.nome ~ ' ' ~ c.segretario.cognome : ''}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati della classe',
        url: path('scuola_classi_edit', {id: c.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella la classe',
        titolo_modale: nome_classe ~ ' - ' ~ c.sede.nomeBreve, contenuto: 'message.cancella_classe'|trans,
        url: path('scuola_classi_delete', {id: c.id})}
    ] %}
    {% set azioni = azioni|merge([{voci: voci}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessuna classe trovata',
    azioni: azioni
      }) }}
  {{ include('admin/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'scuola_classi'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

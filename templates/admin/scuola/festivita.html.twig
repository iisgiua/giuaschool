{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_festivita_edit'), etichetta: 'label.add'|trans, titolo: 'Nuova festività'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.data'|trans, chiave: 'data'},
    {titolo: 'label.descrizione'|trans, chiave: 'descrizione'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for f in dati.lista %}
    {% set data = f.data|date('d/m/Y') %}
    {% set righe = righe|merge([{data: data, descrizione: f.descrizione}]) %}
    {% set azioni = azioni|merge([{voci: [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: 'Mostra i dettagli della festività', titolo_modale: data,
        contenuto: t.info([
          {etichetta: 'label.data'|trans, valore: data, classi_valore: 'col-sm-10'},
          {etichetta: 'label.descrizione'|trans, valore: f.descrizione, classi_valore: 'col-sm-10'}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati della festività',
        url: path('scuola_festivita_edit', {id: f.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella la festività', titolo_modale: data,
        contenuto: 'message.cancella_festivita'|trans, url: path('scuola_festivita_delete', {id: f.id})}
    ]}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessuna festività trovata',
    azioni: azioni,
    paginazione: {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'scuola_festivita'}
  }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

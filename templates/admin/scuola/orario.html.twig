{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina in alto a destra del titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_orario_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo orario'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.nome_orario'|trans, chiave: 'nome'},
    {titolo: 'label.data_inizio'|trans, chiave: 'inizio'},
    {titolo: 'label.sede'|trans, chiave: 'sede'}
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for o in dati %}
    {% set righe = righe|merge([{nome: o.nome, inizio: o.inizio|date('d/m/Y'), sede: o.sede.nomeBreve}]) %}
    {% set voci = [
      {tipo: 'info', etichetta: 'label.show'|trans, titolo: "Mostra i dettagli dell'orario", titolo_modale: o.nome,
        contenuto: t.info([
          {etichetta: 'label.nome_orario'|trans, valore: o.nome, classi_valore: 'col-sm-10'},
          {etichetta: 'label.data_inizio'|trans, valore: o.inizio|date('d/m/Y'), classi_valore: 'col-sm-4'},
          {etichetta: 'label.data_fine'|trans, valore: o.fine|date('d/m/Y'), classi_valore: 'col-sm-4'},
          {etichetta: 'label.sede'|trans, valore: o.sede.nome, classi_valore: 'col-sm-10'}
        ])},
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: "Modifica i dati dell'orario",
        url: path('scuola_orario_edit', {id: o.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: "Cancella l'orario", titolo_modale: o.nome,
        contenuto: 'message.cancella_orario'|trans, url: path('scuola_orario_delete', {id: o.id})},
      {tipo: 'link', etichetta: 'label.scansione_oraria'|trans, titolo: 'Modifica la scansione oraria',
        url: path('scuola_orario_scansione', {id: o.id})}
    ] %}
    {% set azioni = azioni|merge([{voci: voci}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessun orario trovato',
    azioni: azioni
      }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/thfloat.html.twig') }}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

{% extends 'admin/layout-sidebar.html.twig' %}

{% import 'admin/include/tabella.html.twig' as t %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {# pulsanti di pagina sotto il titolo, non in fondo alla tabella #}
  {{ include('admin/include/titolo-bottoni.html.twig', {titolo: titolo|trans, bottoni: [{url: path('scuola_consultazioni_edit'), etichetta: 'label.add'|trans, titolo: 'Nuovo modulo'}]}) }}
  {{ include('admin/include/flash.html.twig') }}
  {% set colonne = [
    {titolo: 'label.stato'|trans, chiave: 'abilitata', tipo: 'stato',
      titolo_vero: 'label.stato_abilitato'|trans, titolo_falso: 'label.stato_disabilitato'|trans},
    {titolo: 'label.nome_consultazione'|trans, chiave: 'nome'},
    {titolo: 'label.inizio'|trans, chiave: 'inizio'},
    {titolo: 'label.fine'|trans, chiave: 'fine'},
  ] %}
  {% set righe = [] %}
  {% set azioni = [] %}
  {% for c in dati %}
    {% set righe = righe|merge([{
      abilitata: c.abilitata,
      nome: c.nome,
      inizio: c.inizio|date('d/m/Y H:i'),
      fine: c.fine|date('d/m/Y H:i'),
    }]) %}
    {% set voci = [
      {tipo: 'link', etichetta: 'label.edit'|trans, titolo: 'Modifica i dati della consultazione',
        url: path('scuola_consultazioni_edit', {id: c.id})},
      {tipo: 'conferma', stile: 'danger', etichetta: 'label.delete'|trans, titolo: 'Cancella la consultazione', titolo_modale: c.nome,
        contenuto: 'message.cancella_consultazione'|trans, url: path('scuola_moduli_delete', {id: c.id})},
    ] %}
    {% if c.abilitata %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'danger', etichetta: 'label.disable'|trans, titolo: 'Disabilita la consultazione',
        titolo_modale: c.nome, contenuto: 'message.disabilita_consultazione'|trans,
        url: path('scuola_moduli_abilita', {id: c.id, abilita: 0})}]) %}
    {% else %}
      {% set voci = voci|merge([{tipo: 'conferma', stile: 'success', etichetta: 'label.enable'|trans, titolo: 'Abilita la consultazione',
        titolo_modale: c.nome, contenuto: 'message.abilita_consultazione'|trans,
        url: path('scuola_moduli_abilita', {id: c.id, abilita: 1})}]) %}
    {% endif %}
    {% set azioni = azioni|merge([{voci: voci}]) %}
  {% endfor %}
  {{ t.tabella(colonne, righe, {
    vuoto: 'Nessuna consultazione trovata',
    mappa: {chiave: 'abilitata', valori: {1: '', 0: 'table-danger'}},
    azioni: azioni,
      }) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/tabella-js.html.twig') }}
{% endblock %}

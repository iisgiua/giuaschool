{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  {{ include('admin/include/flash.html.twig') }}
  <div class="row mb-3">
    <div class="mx-auto">
      <a class="btn btn-success btn-xs gs-modal-confirm-button" title="Scarica i messaggi di errore di sistema" href="{{ path('sistema_manutenzione_log') }}">Log errori</a>
      <button class="btn btn-warning btn-xs ml-4 gs-modal-confirm-button" data-toggle="modal" data-target="#gs-modal-confirm" data-href="{{ path('sistema_manutenzione_debug') }}" title="Attiva o disattiva la modalità di debug nel log di sistema" data-text="{{ (info.logLevel == 'debug' ? 'message.avviso_disattiva_log_level' : 'message.avviso_attiva_log_level')|trans }}" data-csrf="{{ csrf_token('delete') }}">{{ info.logLevel == 'debug' ? 'Disattiva' : 'Attiva' }} debug</button>
      <button class="btn btn-danger btn-xs ml-4 gs-modal-confirm-button" data-toggle="modal" data-target="#gs-modal-confirm" data-href="{{ path('sistema_manutenzione_cache') }}" title="Svuota la cache di sistema" data-text="{{ 'message.avviso_svuota_cache'|trans }}" data-csrf="{{ csrf_token('delete') }}">Svuota cache</button>
      <button class="btn btn-danger btn-xs ml-4 gs-modal-confirm-button" data-toggle="modal" data-target="#gs-modal-confirm" data-href="{{ path('sistema_manutenzione_logout') }}" title="Forza il logout degli altri utenti" data-text="{{ 'message.avviso_logout_utenti'|trans }}" data-csrf="{{ csrf_token('delete') }}">Logout utenti</button>
    </div>
  </div>
  {{ include('admin/include/form-noflash.html.twig', {form: form[0], form_help: form[1]}) }}
  {{ include('admin/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ include('admin/include/datepicker.html.twig', {dp_field: 'configurazione_data_inizio', dp_disabled: null, dp_week: null, dp_min: null, dp_max: null}) }}
{{ include('admin/include/datepicker.html.twig', {dp_field: 'configurazione_data_fine', dp_disabled: null, dp_week: null, dp_min: null, dp_max: null}) }}
<script>
$(document).ready(function() {
  $('#gs-modal-confirm').on('show.bs.modal', function (e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}

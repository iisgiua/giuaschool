{% extends 'admin/layout-sidebar.html.twig' %}

{% block pagina_contenuto %}
<div class="container">
  <h1 class="text-center mb-4">{{ titolo|trans }}</h1>
  <div class="alert alert-{{ info.tipo }} text-center gs-big">
    <strong>{{ (info.messaggio|trans(dati))|raw }}</strong>
  </div>
  {% if info.prossimo > info.step %}
  <div class="text-center">
    <form method="post" action="{{ path('sistema_aggiorna', {step: info.prossimo}) }}" class="d-inline-block">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('sistema_aggiorna') }}">
      <button type="submit" class="btn btn-primary" title="Continua la procedura di aggiornamento"><strong>{{ 'label.continua'|trans }}</strong></button>
    </form>
  </div>
  {% endif %}
</div>
{% endblock %}

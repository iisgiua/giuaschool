{% extends 'ruolo_genitore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {% if classe %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">{{ 'title.genitori_lezioni'|trans }} {{ classe }}</h1>
  {% else %}
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">Classe non definita</h1>
  {% endif %}
  <div class="gs-lessons-nav gs-mb-1">
    {% if data_prec %}<a class="btn btn-success btn-sm" href="{{ path('genitori_lezioni', {'data': data_prec|date('Y-m-d')}) }}" role="button" title="Giorno precedente"><span class="glyphicon glyphicon-chevron-left"></span></a>{% endif %}
    <button class="gs-lessons-nav-date" id="gs-button-date" title="Cambia data"><span class="glyphicon glyphicon-calendar gs-mr-3"></span><strong>{{ info.data_label }}</strong></button>
    {% if data_succ %}<a class="btn btn-success btn-sm" href="{{ path('genitori_lezioni', {'data': data_succ|date('Y-m-d')}) }}" role="button" title="Giorno successivo"><span class="glyphicon glyphicon-chevron-right"></span></a>{% endif %}
  </div>
  {% if errore %}
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ errore }}</strong>
  </div>
  {% else %}
  <table class="gs-lessons-table">
    <thead>
      <tr>
        <th class="col-sm-2">Ora</th>
        <th class="col-sm-2">Materia</th>
        <th class="col-sm-4">Argomenti</th>
        <th class="col-sm-{{ alunno.bes == 'H' ? 2 : 4 }}">Attività</th>
        {% if alunno.bes == 'H' %}<th class="col-sm-2">Sostegno</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for k,v in dati['lezioni'] %}
      <tr>
        <td class="gs-lessons-ora"{% if v.materia|length > 1 %} rowspan="{{ v.materia|length }}"{% endif %}>{{ k }}ª: <span class="gs-lessons-orario">{{ v.inizio }} - {{ v.fine }}</span></td>
        <td>
        {% if not v.materia|first is empty %}
          {% if v.materia|keys|first == 'R:S' %}<span class="gs-lessons-gruppo">Gruppo: Religione</span><br>{% elseif v.materia|keys|first == 'R:N' %}<span class="gs-lessons-gruppo">Gruppo: N.A.</span><br>{% elseif v.materia|keys|first == 'R:A' %}<span class="gs-lessons-gruppo">Gruppo: Mat. Alt.</span><br>{% elseif v.materia|keys|first[0:1] == 'C' %}<span class="gs-lessons-gruppo">Gruppo: {{ classe.anno }}{{ classe.sezione }}-{{ v.materia|keys|first[2:] }}</span><br>{% endif %}
          <strong>{{ v.materia|first }}</strong>
          <span class="gs-lessons-docenti">{% for d in v.docenti|first %}{{ d }}{{ not loop.last ? ', ' }}{% endfor %}</span>
        {% endif %}
        </td>
        <td><small>{{ (v.argomenti|first)|raw }}</small></td>
        <td><small>{{ (v.attivita|first)|raw }}</small></td>
        {% if alunno.bes == 'H' %}
        <td><small>{{ (v.sostegno|first)|raw }}</small></td>
        {% endif %}
      </tr>
        {% for g,m in v.materia|filter((m, g) => g != v.materia|keys|first) %}
      <tr>
        <td>
          {% if g == 'R:S' %}<span class="gs-lessons-gruppo">Gruppo: Religione</span><br>{% elseif g == 'R:N' %}<span class="gs-lessons-gruppo">Gruppo: N.A.</span><br>{% elseif g == 'R:A' %}<span class="gs-lessons-gruppo">Gruppo: Mat. Alt.</span><br>{% elseif g[0:1] == 'C' %}<span class="gs-lessons-gruppo">Gruppo: {{ classe.anno }}{{ classe.sezione }}-{{ g[2:] }}</span><br>{% endif %}
          <strong>{{ m }}</strong>
          <span class="gs-lessons-docenti">{% for d in v.docenti[g] %}{{ d }}{{ not loop.last ? ', ' }}{% endfor %}</span>
        </td>
        <td><small>{{ v.argomenti[g]|raw }}</small></td>
        <td><small>{{ v.argomenti[g]|raw }}</small></td>
          {% if alunno.bes == 'H' %}
        <td><small>{{ v.sostegno[g]|raw }}</small></td>
          {% endif %}
      </tr>
        {% endfor %}
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endblock %}

{% block pagina_css %}
{{ parent() }}
<link href="{{ asset('vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet">
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js') }}"></script>
<script src="{{ asset('vendor/bootstrap-datepicker/locales/bootstrap-datepicker.it.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('#gs-button-date').datepicker({
    format: "yyyy-mm-dd",
    weekStart: 1,
    maxViewMode: 1,
    daysOfWeekDisabled: "0",
    defaultViewDate: "{{ data }}",
    startDate: "{{ app.session.get('/CONFIG/SCUOLA/anno_inizio') }}",
    endDate: "{{ date()|date('Y-m-d') }}",
    datesDisabled: {{ lista_festivi|raw }},
    todayBtn: "linked",
    todayHighlight: true,
    autoclose: true,
    language: "it",
    zIndexOffset: 1200
    });
  $('#gs-button-date').datepicker()
    .on('show', function(ev){
      $('#gs-button-date').datepicker('update', '{{ data }}');
  });
  $('#gs-button-date').datepicker()
    .on('changeDate', function(ev){
      $('#gs-button-date').datepicker('hide');
      url = "{{ path('genitori_lezioni', {'data': '9999-99-99'}) }}";
      url = url.replace("9999-99-99", ev.format());
      window.location.href = url;
  });
});
</script>
{% endblock %}
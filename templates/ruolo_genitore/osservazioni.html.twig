{% extends 'ruolo_genitore/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h1 gs-mt-2 gs-mb-3">{{ 'title.genitori_osservazioni'|trans({'%sex%': (alunno.sesso == 'M' ? 'o' : 'a')}) }} {{ alunno.nome ~ ' ' ~ alunno.cognome }}</h1>
  {% if errore %}
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ errore }}</strong>
  </div>
  {% else %}
    {% for periodo, v in dati %}
      {% if v is not empty %}
  <div class="gs-pobs-wrapper">
  {% set intestazione = [
      {contenuto: 'Data', classi: 'col-sm-2', scope: 'col'},
      {contenuto: 'Materia', classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'Osservazioni', classi: 'col-sm-7', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
      {% for data, v1 in v %}
        {% for k, e in v1 %}
      <tr>
        <td class="gs-pobs-data">{{ e.data }}</td>
        <td>
          <span class="gs-pobs-materia">{{ e.materia }}</span>
          <span class="gs-pobs-docente">{{ e.docente }}</span>
        </td>
        <td>{{ e.testo|raw|nl2br }}</td>
      </tr>
        {% endfor %}
      {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, intestazione: [intestazione], classi: 'gs-pobs-table'}) }}
  </div>
      {% endif %}
    {% else %}
  <div class="alert alert-info" role="alert">
    <strong class="gs-big">Non sono presenti osservazioni</strong>
  </div>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}

{% extends 'documenti/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-2">{{ 'title.documenti_maggio'|trans }}</h1>
  {% if dati is empty %}
  <div class="alert alert-warning" role="alert">
    <strong class="gs-big">{{ 'message.no_cattedra_maggio'|trans }}</strong>
  </div>
  {% else %}
  <div class="help-block gs-text-normal gs-big gs-mb-4"><em>{{ 'message.inserimento_maggio'|trans|raw }}</em></div>
  {% set intestazione = [
      {contenuto: 'label.classe'|trans, classi: 'col-sm-5', scope: 'col'},
      {contenuto: 'label.documento'|trans, classi: 'col-sm-5', scope: 'col'},
      {contenuto: 'label.action'|trans, classi: 'col-sm-2', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
    {% for d in dati %}
      <tr>
        <td>
          <strong>{{ d.anno }}ª {{ d.sezione }}{{ d.gruppo ? ('-' ~ d.gruppo) }}</strong><br>{{ d.corso }} - {{ d.sede }}
        </td>
        <td>
      {% if d.documento %}
          <a href="{{ path('documenti_download', {documento: d.documento.id}) }}" title="Scarica il documento del 15 maggio indicato">
          {{ include('admin/include/icona.html.twig', {nome: 'download', stile: 'outline', classe: 'gs-mr-1'}) }}<strong>{{ d.documento.allegati[0].titolo }}</strong>
          </a><br>
          <small>Dimensione: {{ (d.documento.allegati[0].dimensione / 1000)|number_format(0, ',', '.') }} kB</small>
      {% else %}
          <strong class="gs-big text-danger">{{ 'label.documento_mancante'|trans }}</strong>
      {% endif %}
        </td>
        <td>
      {% if d.add is defined %}
          {{ include('include/bottone-azione.html.twig', {nome: 'plus', etichetta: 'Aggiungi', titolo: 'Inserisci il documento del 15 maggio', url: path('documenti_maggio_add', {classe: d.classe_id})}) }}
      {% endif %}
      {% if d.delete is defined %}
        {{ include('include/bottone-azione.html.twig', {nome: 'trash', etichetta: 'Cancella', titolo: 'Cancella il documento del 15 maggio', stile: 'danger', classi: 'gs-modal-confirm-button', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-href': path('documenti_delete', {documento: d.documento.id}), 'data-text': 'message.cancella_maggio'|trans, 'data-csrf': csrf_token('delete')}}) }}
      {% endif %}
        </td>
      </tr>
    {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped gs-mt-5'}) }}
  {% endif %}
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.cancella_maggio'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
});
});
</script>
{% endblock %}

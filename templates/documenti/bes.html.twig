{% extends 'documenti/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-2">{{ 'title.documenti_bes'|trans }}</h1>
  <div class="help-block gs-text-normal gs-big gs-mb-4"><em>{{ 'message.inserimento_documenti_bes'|trans|raw }}</em>
  </div>
  {{ include('admin/include/flash.html.twig') }}
  {% form_theme form 'bootstrap_3_layout.html.twig' %}
  {{ form_start(form, {attr: {class: 'gs-filters gs-mb-3'}}) }}
    <div class="gs-filters-row">
      <div class="form-group gs-filter-col">
        {{ form_label(form.tipo, null, {label_attr: {class: 'control-label'}}) }}
        {{ form_widget(form.tipo) }}
      </div>
      {% if form.classe is defined %}
      <div class="form-group gs-filter-col">
        {{ form_label(form.classe, null, {label_attr: {class: 'control-label'}}) }}
        {{ form_widget(form.classe) }}
      </div>
      {% endif %}
    </div>
    <div class="gs-filters-buttons">
      {{ form_widget(form.submit) }}
    </div>
  {{ form_end(form) }}
  <div class="gs-filtri-azioni gs-mb-3">
    <a class="btn btn-default" href="{{ path('documenti_archivio_bes') }}" role="button"
      title="Vai all'archivio dei documenti BES">{{ include('admin/include/icona.html.twig', {nome: 'clock', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Archivio</strong></a>
    {% if dati.azioni.add is defined %}
    <a class="btn btn-primary" href="{{ path('documenti_bes_add') }}" role="button"
      title="Inserisci un nuovo documento">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Aggiungi</strong></a>
    {% endif %}
  </div>
  {% if dati.lista is empty %}
  <div class="alert alert-warning gs-mt-2" role="alert">
    <strong class="gs-big">{{ 'message.no_documenti'|trans }}</strong>
  </div>
  {% else %}
  {% set intestazione = [
      {contenuto: 'label.classe'|trans, classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'label.alunno'|trans, classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'label.documento'|trans, classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'label.action'|trans, classi: 'col-sm-3', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
      {% for i, alu in dati.lista %}
        {% set documenti = dati.documenti[i].lista %}
        {% for k, doc in documenti %}
          {# Le azioni del documento stanno in un unico menu a tre puntini, come
             nelle altre pagine: scarica, codice di accesso e le azioni sul
             documento, senza affollare la cella di icone. #}
          {% set voci_documento = [
            {etichetta: 'Scarica documento', titolo: 'Scarica il documento indicato', url: path('documenti_download', {documento: doc.id})},
          ] %}
          {% if doc.cifrato %}
            {% set voci_documento = voci_documento|merge([{etichetta: 'Codice di accesso: ' ~ doc.cifrato}]) %}
          {% endif %}
          {% set voci_azioni = [] %}
          {% if dati.documenti[i].add[k] is defined %}
            {% set voci_azioni = voci_azioni|merge([{etichetta: 'Aggiungi', titolo: "Inserisci il documento per l'alunno BES indicato", url: path('documenti_bes_add', {alunno: alu.id}), classi: 'text-primary'}]) %}
          {% endif %}
          {% if dati.documenti[i].edit[k] is defined %}
            {% set voci_azioni = voci_azioni|merge([{etichetta: 'Archivia', titolo: 'Archivia il documento indicato', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-href': path('documenti_bes_archive', {documento: doc.id}), 'data-text': 'message.archivia_documento_bes'|trans, 'data-csrf': csrf_token('delete')}, classi: 'gs-modal-confirm-button text-warning'}]) %}
          {% endif %}
          {% if dati.documenti[i].delete[k] is defined %}
            {% set voci_azioni = voci_azioni|merge([{etichetta: 'Cancella', titolo: 'Cancella il documento indicato', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-href': path('documenti_delete', {documento: doc.id}), 'data-text': 'message.cancella_documenti_bes'|trans, 'data-csrf': csrf_token('delete')}, classi: 'gs-modal-confirm-button text-danger'}]) %}
          {% endif %}
          {% if voci_azioni is not empty %}
            {% set voci_documento = voci_documento|merge([{separatore: true}])|merge(voci_azioni) %}
          {% endif %}
      <tr>
          {% if loop.first %}
        <td rowspan="{{ documenti|length }}">
          <strong>{{ alu.classe }}</strong>
          <br>{{ alu.classe.corso.nomeBreve }} - {{ alu.classe.sede.citta|upper }}
        </td>
        <td rowspan="{{ documenti|length }}">
          <strong>{{ alu.cognome }} {{ alu.nome }} ({{ alu.dataNascita|date('d/m/Y') }})</strong>
        </td>
          {% endif %}
        <td>
          <strong>{{ doc.allegati[0].titolo }}</strong>
          <br><small>Dimensione: {{ (doc.allegati[0].dimensione / 1000)|number_format(0, ',', '.') }} kB</small>
        </td>
        <td class="text-right">
          {{ include('include/menu-azioni.html.twig', {voci: voci_documento, titolo: 'Azioni sul documento'}) }}
        </td>
      </tr>
        {% endfor %}
      {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped gs-mt-2'}) }}
  {% if dati.maxPagine > 1 %}
  <nav aria-label="Navigazione tra le pagine" class="text-center">
    <ul class="pagination pagination-sm gs-mt-2">
      {% if info.pagina > 1 %}
      <li><a href="{{ path('documenti_bes', {pagina: info.pagina - 1}) }}" title="{{ 'label.precedente'|trans }}"><span
            aria-hidden="true">&laquo;</span></a></li>
      {% else %}
      <li class="disabled"><span title="{{ 'label.precedente'|trans }}"><span aria-hidden="true">&laquo;</span></span>
      </li>
      {% endif %}
      {% for i in 1..dati.maxPagine %}
      <li {{ info.pagina == i ? 'class="active"' }}><a href="{{ path('documenti_bes', {pagina: i}) }}">{{ i }}</a></li>
      {% endfor %}
      {% if info.pagina < dati.maxPagine %} <li><a href="{{ path('documenti_bes', {pagina: info.pagina + 1}) }}"
          title="{{ 'label.successiva'|trans }}"><span aria-hidden="true">&raquo;</span></a></li>
        {% else %}
        <li class="disabled"><span title="{{ 'label.successiva'|trans }}"><span aria-hidden="true">&raquo;</span></span>
        </li>
        {% endif %}
    </ul>
  </nav>
  {% endif %}
  {% endif %}
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.cancella_documenti_bes'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
  $(document).ready(function () {
    $('[data-toggle="popover"]').popover();
    $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
});
  });
</script>
{% endblock %}

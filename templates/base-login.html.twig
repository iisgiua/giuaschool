  <body class="gs-login-page">
    <p class="gs-mb-0">
      <a href="#gs-main" class="sr-only sr-only-focusable">Vai al contenuto</a>
    </p>

    <!-- login page container -->
    <div class="gs-login-container" id="gs-top">

      <!-- simple header with logo and back button -->
      <div class="gs-login-header">
        <div class="gs-login-content-wrapper">
{% if block('pagina_back_button') is not empty %}
          <div class="row gs-vertical-center gs-header-spacing">
            <div class="col-xs-6 col-sm-5">
{% block pagina_back_button %}
              <a href="{{ path('login_form') }}" class="btn btn-default gs-back-button">
                <span class="glyphicon glyphicon-arrow-left gs-mr-2"></span>Torna al Login
              </a>
{% endblock %}
            </div>
            <div class="col-xs-6 col-sm-7 gs-logo-title-container gs-logo-right">
              <a href="{{ path('login_form') }}" class="gs-login-logo">
                <img src="{{ asset('img/logo-giuaschool.png') }}" alt="{{ app.session.get('/CONFIG/ISTITUTO/intestazione_breve') }}">
              </a>
              <h1 class="gs-login-title">{{ app.session.get('/CONFIG/ISTITUTO/intestazione_breve') }}</h1>
              {% if is_granted('IS_AUTHENTICATED_FULLY') %}
              <p class="gs-login-subtitle">{{ app.session.get('/CONFIG/SISTEMA/anno_scolastico') }}</p>
              {% endif %}
            </div>
          </div>
{% else %}
          <div class="text-center gs-logo-centered">
            <a href="{{ path('login_form') }}" class="gs-login-logo">
              <img src="{{ asset('img/logo-giuaschool.png') }}" alt="{{ app.session.get('/CONFIG/ISTITUTO/intestazione_breve') }}">
            </a>
            <h1 class="gs-login-title">{{ app.session.get('/CONFIG/ISTITUTO/intestazione_breve') }}</h1>
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <p class="gs-login-subtitle">{{ app.session.get('/CONFIG/SISTEMA/anno_scolastico') }}</p>
            {% endif %}
          </div>
{% endif %}
        </div>
      </div>

      <!-- contenuto -->
      <div class="gs-login-main">
        <div class="gs-login-content-wrapper">
          <div id="gs-main">
{% block pagina_contenuto %}
{% endblock %}
          </div>
        </div>
      </div>

    </div>

    <!-- piè di pagina -->
      {{ include('footer.html.twig') }}
    <!-- fine piè di pagina -->

    <script src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap/js/bootstrap.min.js') }}"></script>
    <!--[if IE 10]>
    <script src="{{ asset('vendor/bootstrap/js/ie10-viewport-bug-workaround.js') }}"></script>
    <![endif]-->
    <script src="{{ asset('js/script.js?v=' ~ (filedate('js/script.js')|date('U'))) }}"></script>
  <script src="{{ asset('js/notifiche.js?v=' ~ (filedate('js/notifiche.js')|date('U'))) }}"></script>
{% block pagina_js_fine %}
{% endblock %}
  </body>
</html>

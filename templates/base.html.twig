    <script>
    /* pannello di navigazione mobile: apre/chiude la barra laterale sotto i 992px */
    (function () {
      var html = document.documentElement;
      var btn = document.querySelector('.gs-hdr-toggle');
      var panel = document.getElementById('gs-navbar-collapse-1');
      var overlay = document.querySelector('.gs-hdr-overlay');
      if (!btn || !panel) { return; }
      var desktop = window.matchMedia('(min-width: 992px)');

      function setOpen(open) {
        panel.classList.toggle('is-open', open);
        if (overlay) { overlay.classList.toggle('is-visible', open); }
        html.classList.toggle('gs-hdr-lock', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Chiudi il menu di navigazione' : 'Apri il menu di navigazione');
      }

      btn.addEventListener('click', function () {
        setOpen(!panel.classList.contains('is-open'));
      });
      if (overlay) {
        overlay.addEventListener('click', function () { setOpen(false); });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && panel.classList.contains('is-open')) {
          setOpen(false);
          btn.focus();
        }
      });
      panel.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('a') : null;
        if (a && !a.classList.contains('dropdown-toggle') && a.getAttribute('href') !== '#') {
          setOpen(false);
        }
      });
      function onResize() {
        if (desktop.matches) { setOpen(false); }
      }
      if (desktop.addEventListener) { desktop.addEventListener('change', onResize); }
      else if (desktop.addListener) { desktop.addListener(onResize); }
    })();

    /* Dropdown toggle per menu sidebar
       Le sezioni si aprono e chiudono con un solo commando: il <a> non porta
       data-toggle="dropdown", cosi' il Bootstrap 3 non commuta la classe open
       insieme a questo codice e la sezione non si richiude subito. */
    (function () {
      var menu = document.querySelector('.gs-hdr-menu');
      if (!menu) { return; }
      menu.addEventListener('click', function (e) {
        var toggle = e.target.closest ? e.target.closest('.dropdown-toggle') : null;
        if (!toggle || !menu.contains(toggle)) { return; }
        e.preventDefault();
        var parentLi = toggle.parentElement;
        var dropdownMenu = parentLi.querySelector('.dropdown-menu');
        if (!dropdownMenu) { return; }
        var aperta = !parentLi.classList.contains('open');
        menu.querySelectorAll('li.dropdown.open').forEach(function (li) {
          li.classList.remove('open');
          var altroToggle = li.querySelector(':scope > .dropdown-toggle');
          if (altroToggle) { altroToggle.setAttribute('aria-expanded', 'false'); }
        });
        if (aperta) { parentLi.classList.add('open'); }
        toggle.setAttribute('aria-expanded', aperta ? 'true' : 'false');
      });
    })();
    </script>

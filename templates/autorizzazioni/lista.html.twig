{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-autorizzazioni-lista">
  <h1 class="text-center gs-h2 gs-mt-2">{{ titolo|trans }}</h1>
  <form name="{{ form[0].vars.name }}" method="{{ form[0].vars.method }}" action="{{ form[0].vars.action }}" class="gs-filters gs-mb-3">
    <div id="filtro">
      <div class="gs-filters-row">
        <div class="gs-filter-col">
          {{ form_label(form[0].sede, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form[0].sede) }}
        </div>
        <div class="gs-filter-col">
          {{ form_label(form[0].classe, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form[0].classe) }}
        </div>
      </div>
      <div class="gs-filters-buttons">
        {{ form_widget(form[0].submit) }}
      </div>
      {{ form_widget(form[0]._token) }}
    </div>
  </form>
  <div class="row gs-mb-1">
    <div class="col-sm-offset-6  col-sm-6 text-right">
      <a class="btn btn-sm btn-primary gs-mr-2" href="{{ path('autorizzazioni_edit') }}" role="button" title="Inserisci un nuovo modulo di autorizzazione delle attività">{{ include('admin/include/icona.html.twig', {nome: 'plus', stile: 'outline', classe: 'gs-mr-2'}) }}<strong>Nuovo</strong></a>
    </div>
  </div>
  {% if dati.lista|length == 0 %}
  <div class="alert alert-info text-center gs-big">
    <strong>Non sono presenti dati</strong>
  </div>
  {% else %}
  {% set intestazione = [
      {contenuto: 'label.abilitato'|trans, classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'label.sede'|trans, classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'label.classi'|trans, classi: 'col-sm-2', scope: 'col'},
      {contenuto: 'label.tipo'|trans, classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'label.data'|trans, classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'label.nome'|trans, classi: 'col-sm-3', scope: 'col'},
      {contenuto: 'label.action'|trans, classi: 'col-sm-3', scope: 'col'},
    ] %}
    {% set corpo_grezzo_0 %}
    {% for a in dati.lista %}
      <tr{% if not a.abilitata %} style="background-color: #f2dede;"{% endif %}>
        <td>{% if a.abilitata %}<div class="text-success gs-big">{{ include('admin/include/icona.html.twig', {nome: 'check', stile: 'outline', titolo: 'Modulo di autorizzazione abilitato'}) }}</div>{% else %}<div class="text-danger gs-big">{{ include('admin/include/icona.html.twig', {nome: 'ban', stile: 'outline', titolo: 'Modulo di autorizzazione non abilitato'}) }}</div>{% endif %}</td>
        <td>{% if a.sede is empty %}TUTTE{% else %}{{ a.sede|upper }}{% endif %}</td>
        <td>{% if a.classi is empty %}TUTTE{% else %}{{ dati.info[a.id].classi }}{% endif %}</td>
        <td>{{ ('label.tipo_attivita_' ~ a.tipo)|trans }}</td>
        <td>{{ a.inizio|date('d/m/Y') }}</td>
        <td><strong>{{ a.nome }}</strong></td>
        <td>
          {% set voci_azioni = [
            {etichetta: 'Anteprima', titolo: 'Visualizza l\'anteprima del modulo di autorizzazione', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote', 'data-href': path('autorizzazioni_anteprima', {autorizzazione: a.id}), 'data-tipo': ('label.tipo_attivita_' ~ a.tipo)|trans, 'data-nome': a.nome}, classi: 'gs-button-remote'},
            {etichetta: 'label.edit'|trans, titolo: 'Modifica i dati del modulo di autorizzazione', url: path('autorizzazioni_edit', {autorizzazione: a.id})},
            {etichetta: 'label.show'|trans, titolo: 'Dettagli delle autorizzazioni inviate', url: path('autorizzazioni_dettagli', {modulo: a.id})},
          ] %}
      {% if a.abilitata %}
          {% set voci_azioni = voci_azioni|merge([{etichetta: 'label.disable'|trans, titolo: 'Disabilita il modulo di autorizzazione', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-titolo': a.nome, 'data-contenuto': 'message.disabilita_autorizzazione'|trans, 'data-href': path('autorizzazioni_abilita', {autorizzazione: a.id, abilita: 0}), 'data-csrf': csrf_token('delete')}, classi: 'gs-modal-confirm-button text-danger'}]) %}
      {% else %}
          {% set voci_azioni = voci_azioni|merge([{etichetta: 'label.enable'|trans, titolo: 'Abilita il modulo di autorizzazione', attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm', 'data-titolo': a.nome, 'data-contenuto': 'message.abilita_autorizzazione'|trans, 'data-href': path('autorizzazioni_abilita', {autorizzazione: a.id, abilita: 1}), 'data-csrf': csrf_token('delete')}, classi: 'gs-modal-confirm-button text-success'}]) %}
      {% endif %}
          {{ include('include/menu-azioni.html.twig', {voci: voci_azioni, titolo: 'Azioni sul modulo di autorizzazione'}) }}
        </td>
      </tr>
    {% endfor %}
    {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
    {{ include('include/paginate.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'autorizzazioni_lista'}) }}
    {{ include('include/modal-remote.html.twig') }}
  {% endif %}
  {{ include('admin/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  // Aggiungi opzione vuota alle select se sono vuote
  if ($('#filtro_sede option').length === 0) {
    $('#filtro_sede').prepend('<option value="">Tutte le sedi</option>');
  }
  if ($('#filtro_classe option').length === 0) {
    $('#filtro_classe').prepend('<option value="">Tutte le classi</option>');
  }
  $('#filtro_sede').change(function(e) {
    if ($(this).val()) {
      $('#filtro_classe optgroup').hide();
      $('#filtro_classe optgroup[label="'+sedi[$(this).val()]+'"]').show();
      if ($('#filtro_classe').find("option:selected").parent().attr('label') != sedi[$(this).val()]) {
        $('#filtro_classe').val('');
      }
    } else {
      $('#filtro_classe optgroup').show();
    }
  });
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href');
    var tipo = $(event.relatedTarget).data('tipo');
    var nome = $(event.relatedTarget).data('nome');
    var html = '<div class="modal-header"><button type="button" class="close" data-dismiss="modal"><svg class="icon icon-outline gs-mr-2" aria-hidden="true"><use xlink:href="{{ asset('icons/tabler-sprite.svg') }}#x"></use></svg><span class="sr-only">Chiudi</span></button><h3 class="modal-title gs-h3">'+nome+'</h3><h4 class="modal-title gs-h4">'+tipo+'</h4></div><div class="modal-body bg-info"></div><div class="modal-footer gs-pb-2 gs-pt-0 gs-pr-2 gs-pl-2"><div class="text-center gs-pt-2 gs-pb-2"><button type="button" class="btn btn-default gs-mb-3" data-dismiss="modal"><strong>Chiudi</strong></button></div></div>';
    $('#gs-modal-remote-content').html(html);
    $(this).find('#gs-modal-remote-content .modal-body').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
  // init
  var sedi = [];
  {% for s, n in info.sedi %}
  sedi[{{ s }}] = '{{ n }}';
  {% endfor %}
  $('#filtro_sede').change();
  $('#gs-modal-confirm').on('show.bs.modal', function(e) {
    var href = $(e.relatedTarget).data('href');
    var csrf = $(e.relatedTarget).data('csrf');
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
  });
});
</script>
{% endblock %}

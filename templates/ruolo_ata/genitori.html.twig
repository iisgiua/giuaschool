{% extends 'ruolo_ata/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-0">{{ 'title.segreteria_genitori'|trans }}</h1>
  {% form_theme form 'bootstrap_3_layout.html.twig' %}
  <form name="{{ form.vars.name }}" method="{{ form.vars.method }}" action="{{ form.vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form.vars.id }}">
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col">
          {{ form_label(form.cognome, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form.cognome) }}
        </div>
        <div class="form-group gs-filter-col">
          {{ form_label(form.nome, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form.nome) }}
        </div>
      </div>
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col">
          {{ form_label(form.classe, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form.classe) }}
        </div>
      </div>
      <div class="gs-filters-buttons">
        {{ form_widget(form.submit) }}
      </div>
      {{ form_widget(form._token) }}
    </div>
  </form>
  {% set intestazione = [
      {contenuto: 'label.alunno'|trans, classi: 'col-sm-4', scope: 'col'},
      {contenuto: 'label.classe'|trans, classi: 'col-sm-1', scope: 'col'},
      {contenuto: 'label.genitori'|trans, classi: 'col-sm-5', scope: 'col'},
      {contenuto: 'label.action'|trans, classi: 'col-sm-2', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
    {% for a in lista.lista %}
      <tr>
        <td>{{ a.cognome }} {{ a.nome }} ({{ a.dataNascita|date('d/m/Y') }})</td>
        <td>{{ a.classe ? a.classe : 'Non definita' }}</td>
        <td>
      {% for g in lista.genitori[a.id] %}
          {{ include('admin/include/icona.html.twig', {nome: (g.spid ? 'check' : 'ban'), stile: 'outline', classe: (g.spid ? 'text-success' : 'text-danger') ~ ' gs-big'}) }}
            Genitore {{ loop.index }}{{ ('#' not in (g.nome ~ g.cognome)) ? (': ' ~ g.nome ~ ' ' ~ g.cognome ~ ' - ' ~ g.codiceFiscale) }}<br>
      {% endfor %}
        </td>
        <td>
          {{ include('include/bottone-azione.html.twig', {nome: 'pencil', etichetta: 'label.edit'|trans, titolo: 'Clicca per modificare le impostazioni', url: path('segreteria_genitori_edit', {alunno: a.id})}) }}
        </td>
      </tr>
    {% endfor %}
  {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover table-striped'}) }}
  {% if lista.maxPagine > 1 %}
  <nav aria-label="Navigazione tra le pagine" class="text-center">
    <ul class="pagination pagination-sm gs-mt-2">
    {% if page > 1 %}
      <li><a href="{{ path('segreteria_genitori', {pagina: page - 1}) }}" title="{{ 'label.precedente'|trans }}"><span aria-hidden="true">&laquo;</span></a></li>
    {% else %}
      <li class="disabled"><span title="{{ 'label.precedente'|trans }}"><span aria-hidden="true">&laquo;</span></span></li>
    {% endif %}
    {% for i in 1..lista.maxPagine %}
      <li {{ page == i ? 'class="active"' }}><a href="{{ path('segreteria_genitori', {pagina: i}) }}">{{ i }}</a></li>
    {% endfor %}
    {% if page < lista.maxPagine %}
      <li><a href="{{ path('segreteria_genitori', {pagina: page + 1}) }}" title="{{ 'label.successiva'|trans }}"><span aria-hidden="true">&raquo;</span></a></li>
    {% else %}
      <li class="disabled"><span title="{{ 'label.successiva'|trans }}"><span aria-hidden="true">&raquo;</span></span></li>
    {% endif %}
    </ul>
  </nav>
  {% endif %}
</div>
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.nuova_password_classe'}) }}
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    $(this).find('#gs-modal-confirm-yes').attr('href', href);
  });
  $('#gs-modal-confirm-yes').on('click', function (event) {
    $('#gs-modal-confirm').modal('hide');
  });
});
</script>
{% endblock %}

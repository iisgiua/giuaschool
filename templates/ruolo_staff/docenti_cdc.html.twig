{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-docenti-cdc">
  <h1 class="text-center gs-h2 gs-mt-2">{{ titolo|trans }}</h1>
  <form name="{{ form[0].vars.name }}" method="{{ form[0].vars.method }}" action="{{ form[0].vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form[0].vars.id }}">
      <div class="gs-filters-row">
        <div class="gs-filter-col">
          {{ form_label(form[0].classe, null, {label_attr: {class: 'control-label'}}) }}
          {{ form_widget(form[0].classe) }}
        </div>
      </div>
      <div class="gs-filters-buttons">
        {{ form_widget(form[0].submit) }}
      </div>
      {{ form_widget(form[0]._token) }}
    </div>
  </form>
  {% if dati|length == 0 %}
  <div class="alert alert-info text-center gs-big">
    <strong>Non sono presenti dati</strong>
  </div>
  {% else %}
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h3 class="panel-title text-center">
        <strong>Classe {{ info.classe }} - {{ info.classe.corso }} - {{ info.classe.sede.nomeBreve }}</strong>
      </h3>
    </div>
    {% set intestazione = [
      {contenuto: 'Docente', classi: 'col-sm-4', scope: 'col'},
      {contenuto: 'Materie', classi: 'col-sm-6', scope: 'col'},
      {contenuto: 'Incarico', classi: 'col-sm-2', scope: 'col'}
    ] %}
    {% set corpo_grezzo_0 %}
    {% for d, c in dati %}
        <tr>
          <td class="gs-big">{{ c[0].docente.cognome }} {{ c[0].docente.nome }}</td>
          <td>
      {% for cc in c %}
        {% if cc.tipo == 'P' %}
            <em>Potenziamento su {{ cc.materia.nome }}</em>
        {% else %}
            <span>{{ cc.tipo == 'I' ? 'Lab. ' }}{{ cc.materia.nome }}</span>
        {% endif %}
            {% if cc.supplenza %} - <strong>SUPPLENTE di {{ cc.docenteSupplenza.cognome }} {{ cc.docenteSupplenza.nome }}</strong>{% endif %}<br>
      {% endfor %}
          </td>
          <td class="gs-big">
      {% if info.classe.coordinatore and info.classe.coordinatore.id == c[0].docente.id %}
            <strong>COORDINATORE</strong>
      {% elseif info.classe.segretario and info.classe.segretario.id == c[0].docente.id %}
            <span>SEGRETARIO</span>
      {% endif %}
          </td>
        </tr>
    {% endfor %}
      {% endset %}
    {{ include('include/tabella.html.twig', {corpo_grezzo: corpo_grezzo_0, classi: 'table table-bordered table-hover', classe_intestazione: 'bg-info'}) }}
  </div>
  {% endif %}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
{% endblock %}

{% extends 'utenti/index.html.twig' %}

{% form_theme form[0] _self %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h1 gs-mt-3 gs-mb-3">{{ titolo|trans }}</h1>
  {{ form_start(form[0]) }}
  {{ form_errors(form[0]) }}
  <div class="panel panel-primary">
    <div class="panel-heading">
      <h3 class="panel-title gs-h3">{{ form[1]|trans }}</h3>
    </div>
    <div class="panel-body">
      <div id="notifica_tipo" class="gs-mt-3 gs-mr-4 gs-ml-4">
        <legend class="gs-h3 gs-mb-2">Canale per l'invio delle notifiche:</legend>
        {{ form_widget(form[0].tipo) }}
      </div>
      <div id="notifica_abilitato" class="gs-mt-5 gs-mr-4 gs-ml-4">
        <legend class="gs-h3 gs-mb-2">Tipo di evento da notificare:</legend>
        {{ form_widget(form[0].abilitato) }}
      </div>
    </div>
    <div class="panel-footer text-center">
      {{ form_widget(form[0].submit) }}
      {{ form_widget(form[0].cancel) }}
    </div>
  </div>
  {{ form_end(form[0]) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('.gs-row-radio input[type="radio"]').change(function() {
    $('.gs-row-radio').removeClass('list-group-item-info');
    $(this).closest('.gs-row-radio').addClass('list-group-item-info');
  });
  $('.gs-row-checkbox input[type="checkbox"]').change(function() {
    $(this).closest('.gs-row-checkbox').toggleClass('list-group-item-info', $(this).prop('checked'));
  });
  // init
  $('.gs-row-radio:has(input:checked)').addClass('list-group-item-info');
  $('.gs-row-checkbox:has(input:checked)').addClass('list-group-item-info');
});
</script>
{% endblock %}

{% block _notifica_tipo_widget %}
<div class="list-group">
  {% for item in form.children %}
  <label for="{{ item.vars.id }}" class="list-group-item gs-row-radio">
    <div class="row">
      <div class="col-sm-6">
        <input type="radio" id="{{ item.vars.id }}" name="{{ item.vars.full_name }}" required="required" value="{{ item.vars.value }}"{{ item.vars.checked ? ' checked="checked"'}}{{ item.vars.attr['disabled'] is defined ? ' disabled="disabled"'}}> <strong>{{ item.vars.label|trans }}</strong>
      </div>
      <div class="col-sm-6"><em>{{ ('message.tipo_notifica_'~item.vars.value)|trans }}</em></div>
    </div>
  </label>
  {% endfor %}
</div>
{% endblock %}

{% block _notifica_abilitato_widget %}
<div class="list-group">
  {% for item in form.children %}
    {% if item.vars.value in ['circolare', 'avviso'] %}
  <label for="{{ item.vars.id }}" class="list-group-item gs-row-checkbox">
    <div class="row">
      <div class="col-sm-6">
        <input type="checkbox" id="{{ item.vars.id }}" name="{{ item.vars.full_name }}" value="{{ item.vars.value }}"{{ item.vars.checked ? ' checked="checked"'}}> <strong>{{ item.vars.label|trans }}</strong>
      </div>
      <div class="col-sm-6"><em>{{ ('message.abilitato_notifica_'~item.vars.value)|trans }}</em></div>
    </div>
  </label>
    {% elseif app.user.controllaRuolo('GA') %}
  <label for="{{ item.vars.id }}" class="list-group-item gs-row-checkbox">
    <div class="row">
      <div class="col-sm-6">
        <input type="checkbox" id="{{ item.vars.id }}" name="{{ item.vars.full_name }}" value="{{ item.vars.value }}"{{ item.vars.checked ? ' checked="checked"'}}> <strong>{{ item.vars.label|trans }}</strong>
      </div>
      <div class="col-sm-6"><em>{{ ('message.abilitato_notifica_'~item.vars.value)|trans }}</em></div>
    </div>
  </label>
    {% endif %}
  {% endfor %}
</div>
{% endblock %}
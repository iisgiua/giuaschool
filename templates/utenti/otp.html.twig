{% extends 'utenti/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <div class="panel panel-primary gs-mt-5">
    <div class="panel-heading">
      <div class="panel-title">{{ 'title.procedura_otp'|trans }}</div>
    </div>
    <div class="panel-body">
      {% form_theme form 'bootstrap_3_layout.html.twig' %}
      {% if form_success %}
      <div class="has-success"><span class="help-block"><strong>{{ include('admin/include/icona.html.twig', {nome: 'check', stile: 'outline', classe: 'gs-mr-2'}) }}{{ form_success|trans }}</strong></span></div>
      {% endif %}
      {% if form_help %}
      <div class="help-block">{{ form_help|trans }}</div>
      {% endif %}
      {{ form_start(form) }}
  {% if reset %}
      <div class="gs-big gs-pt-3">
        <div class="gs-pb-5">
          <strong>L'OTP è stato già associato all'applicazione.
            Per disattivarlo inserisci la password di accesso e clicca sul pulsante di CONFERMA.</strong>
        </div>
        {{ form_row(form.current_password) }}
      </div>
  {% else %}
      <div class="pull-left gs-pl-3 gs-pr-5 gs-pt-3 gs-pb-3">
        <img src="{{ qrcode }}" alt="QRcode">
      </div>
      <div class="pull-left gs-pt-3">
        <ol class="gs-big">
          <li>Scarica e installa sul tuo telefono l'app <em>Google Authenticator</em> disponibile ai seguenti indirizzi:<br>
            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank">Google Play Store</a> (per dispositivi Android)<br>
            <a href="https://apps.apple.com/it/app/google-authenticator/id388497605" target="_blank">Apple App Store</a> (per dispositivi IOS)
          </li>
          <li>Avvia l'app <em>Google Authenticator</em> e inquadra con la fotocamera il <em>QRcode</em> mostrato a lato.</li>
          <li>Inserisci e conferma il codice che verrà visualizzato dall'app:
            {{ form_row(form.otp) }}
          </li>
        </ol>
      </div>
      <div class="clearfix"></div>
  {% endif %}
      {# Annulla e Conferma nello stesso contenitore: il flex li tiene sulla stessa riga #}
      <div class="gs-otp-azioni">
        {{ form_widget(form.cancel) }}
        {{ form_widget(form.submit) }}
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}

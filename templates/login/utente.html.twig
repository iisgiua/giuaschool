{% extends 'base.html.twig' %}

{% block pagina_contenuto %}
<div class="container_fluid gs-mt-5 gs-ml-3 gs-mr-3">
  {# --- banner --- #}
  {% if app.session.get('/CONFIG/SISTEMA/banner_login') %}
  <div class="alert alert-warning gs-mb-2 gs-ml-3 gs-mr-3" role="alert"><strong class="gs-big">{{ app.session.get('/CONFIG/SISTEMA/banner_login')|raw }}</strong></div>
  {% endif %}
  {# --- messaggio di errore --- #}
  {% if errore %}
  <div class="alert alert-danger gs-mt-4 gs-mb-4 gs-big" role="alert">{{ errore.message|trans }}</div>
  {% endif %}

  {# --- GOOGLE attivo --- #}
  {% if app.session.get('/CONFIG/ACCESSO/id_provider') and app.session.get('/CONFIG/ACCESSO/id_provider_tipo') == 'A' %}
  <div class="gs-row-eq-container gs-mb-2">
    <div class="panel panel-success gs-mb-2 gs-row-eq-col2">
      <div class="panel-heading gs-pt-1 gs-pb-1">
        <div class="panel-title text-center">
          <strong>Accesso ALUNNI</strong>
        </div>
      </div>
      <div class="panel-body gs-pt-1 gs-pb-1">
        <div class="help-block"><span class="gs-text-normal">Clicca sul pulsante <strong>"Entra con GOOGLE"</strong> e poi inserisci, nella pagina successiva mostrata da <em>Google</em>, l'<strong>email</strong> istituzionale (@{{ app.session.get('/CONFIG/ACCESSO/id_provider_dominio') }}) e la <strong>password</strong>.</span></div>
        <div class="text-center gs-mt-5">
          <a href="{{ path('login_gsuiteUtente') }}" class="btn btn-success"><strong>Entra con GOOGLE</strong></a>
        </div>
        <p class="gs-mt-5 gs-mb-0"><strong><em>Password Google dimenticata? <a href="https://accounts.google.com/signin/recovery">Vai al recupero password dell'utente Google</a></em></strong></p>
      </div>
    </div>
    <div class="gs-row-eq-space">
      &nbsp;
    </div>
    <div class="panel panel-primary gs-mb-2 gs-row-eq-col2">
      <div class="panel-heading gs-pt-1 gs-pb-1">
        <div class="panel-title text-center"><strong>Accesso altri utenti</strong></div>
      </div>
      <div class="panel-body gs-pt-1 gs-pb-1">
        <div class="help-block"><span class="gs-text-normal">Inserisci nei campi sottostanti l'<strong>utente</strong> e la <strong>password</strong>, quindi clicca sul pulsante <strong>"Entra"</strong>.</span></div>
        <form name="login_utente" method="post" class="form-horizontal">
          <div class="form-group">
            <label for="username" class="sr-only">{{ 'label.username'|trans }}</label>
            <div class="input-group gs-ml-4 gs-mr-4">
              <div class="input-group-addon"><span class="glyphicon glyphicon-user"></span></div>
              <input type="text" class="form-control" id="username" name="_username" required="required" placeholder="{{ 'label.username'|trans }}" value="{{ username }}">
            </div>
          </div>
          <div class="form-group">
            <label for="password" class="sr-only">{{ 'label.password'|trans }}</label>
            <div class="input-group gs-ml-4 gs-mr-4">
              <div class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></div>
              <input type="password" class="form-control" id="password" name="_password" required="required" placeholder="{{ 'label.password'|trans }}" value="">
            </div>
          </div>
          <div class="form-group text-center gs-mb-2">
            <button type="submit" class="btn btn-info" id="login" name="login"><strong>Entra</strong></button>
          </div>
          <p class="gs-mb-0"><strong><em>Password dimenticata? <a href="{{ path('login_recovery') }}">Vai al recupero password</a></strong></em></p>
          <input type="hidden" id="csrf_token" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </form>
      </div>
    </div>
  </div>
  {% else %}
  {# --- GOOGLE non attivo --- #}
  <div class="col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2 gs-mt-4">
    <div class="panel panel-primary" >
      <div class="panel-heading gs-pt-1 gs-pb-1">
        <div class="panel-title text-center"><strong>Accesso al Registro Elettronico</strong></div>
      </div>
      <div class="panel-body gs-pt-1 gs-pb-1">
        <div class="help-block"><span class="gs-text-normal">Inserisci nei campi sottostanti l'<strong>utente</strong> e la <strong>password</strong>, quindi clicca sul pulsante <strong>"Entra"</strong>.</span></div>
        <form name="login_utente" method="post" class="form-horizontal">
          <div class="form-group">
            <label for="username" class="sr-only">{{ 'label.username'|trans }}</label>
            <div class="input-group gs-ml-4 gs-mr-4">
              <div class="input-group-addon"><span class="glyphicon glyphicon-user"></span></div>
              <input type="text" class="form-control" id="username" name="_username" required="required" placeholder="{{ 'label.username'|trans }}" value="{{ username }}">
            </div>
          </div>
          <div class="form-group">
            <label for="password" class="sr-only">{{ 'label.password'|trans }}</label>
            <div class="input-group gs-ml-4 gs-mr-4">
              <div class="input-group-addon"><span class="glyphicon glyphicon-lock"></span></div>
              <input type="password" class="form-control" id="password" name="_password" required="required" placeholder="{{ 'label.password'|trans }}" value="">
            </div>
          </div>
          <div class="form-group text-center gs-mb-2">
            <button type="submit" class="btn btn-info" id="login" name="login"><strong>Entra</strong></button>
          </div>
          <p class="gs-mb-0"><strong><em>Password dimenticata? <a href="{{ path('login_recovery') }}">Vai al recupero password</a></strong></em></p>
          <input type="hidden" id="csrf_token" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </form>
      </div>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

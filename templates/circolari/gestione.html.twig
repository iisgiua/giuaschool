{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  <h1 class="text-center gs-h2 gs-mt-2 gs-mb-0">{{ 'title.circolari_gestione'|trans }}</h1>
  <div class="row gs-mb-0">
    <div class="col-sm-offset-6 col-sm-6 text-right">
  {% if dati.azioni.add is defined %}
      <a class="btn btn-primary btn-sm" href="{{ path('circolari_edit', {circolare: 0}) }}" role="button" title="Inserisci una nuova circolare"><span class="glyphicon glyphicon-plus gs-mr-2"></span>Aggiungi</a>
  {% endif %}
    </div>
  </div>
  {% if info.pagina == 1 and dati.bozza|length > 0 %}
  {% set intestazione = [
    {contenuto: 'label.data'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.numero'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.sede'|trans, classi: 'col-sm-2', scope: 'col'},
    {contenuto: 'label.oggetto'|trans, classi: 'col-sm-6', scope: 'col'},
    {contenuto: 'label.action'|trans, classi: 'col-sm-2', scope: 'col'}
  ] %}
  {% set righe = [] %}
  {% for k, c in dati.bozza %}
    {% set pulsanti = [] %}
    {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
      nome: 'eye', etichetta: 'Visualizza', titolo: 'Visualizza i dettagli della circolare',
      classi: 'gs-button-remote',
      attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote',
                  'data-href': path('circolari_dettagli_gestione', {circolare: c.id})}})]) %}
    {% if dati.azioni['unpublish-' ~ k].edit is defined %}
      {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
        nome: 'pencil', etichetta: 'Modifica', titolo: 'Modifica la circolare indicata',
        url: path('circolari_edit', {circolare: c.id})})]) %}
    {% endif %}
    {% if dati.azioni['unpublish-' ~ k].publish is defined %}
      {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
        nome: 'book', etichetta: 'Pubblica', titolo: 'Pubblica la circolare indicata', stile: 'success',
        url: path('circolari_publish', {circolare: c.id, pubblica: 1})})]) %}
    {% endif %}
    {% if dati.azioni['unpublish-' ~ k].delete is defined %}
      {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
        nome: 'trash', etichetta: 'Cancella', titolo: 'Cancella la circolare indicata', stile: 'danger',
        classi: 'gs-modal-confirm-button',
        attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-confirm',
                    'data-href': path('circolari_delete', {circolare: c.id}),
                    'data-text': 'message.cancella_circolare'|trans,
                    'data-csrf': csrf_token('delete')}})]) %}
    {% endif %}
    {% set righe = righe|merge([{celle: [
      {contenuto: c.data|date('d/m/Y')},
      {contenuto: c.numero},
      {contenuto: '<small>' ~ c.sedi|map(s => s.citta|upper)|join(', ') ~ '</small>'},
      {contenuto: '<small>' ~ c.titolo ~ '</small>'},
      {contenuto: pulsanti}
    ]}]) %}
  {% endfor %}
  {{ include('include/tabella.html.twig', {
    didascalia: 'Circolari in stato di bozza',
    classi_didascalia: 'text-center text-warning gs-pb-0',
    intestazione: [intestazione], corpo: righe,
    classe_intestazione: 'bg-warning'
  }) }}
  <div class="row gs-mt-2">
    <div class="col-sm-offset-6 col-sm-6 text-right">
    {% if dati.azioni.add is defined %}
      <a class="btn btn-primary btn-sm" href="{{ path('circolari_edit', {circolare: 0}) }}" role="button" title="Inserisci una nuova circolare"><span class="glyphicon glyphicon-plus gs-mr-2"></span>Aggiungi</a>
    {% endif %}
    </div>
  </div>
  {% endif %}
  <div class="text-center text-success gs-pb-0"><strong class="gs-big">Circolari pubblicate</strong></div>
  <form name="{{ form.vars.name }}" method="{{ form.vars.method }}" action="{{ form.vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form.vars.id }}">
      <div class="gs-filters-row">
        <div class="gs-filter-col">
          {{ form_label(form.inizio) }}
          <div class="input-group date">
            {{ form_widget(form.inizio, {attr: {widget: false}}) }}
            <span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-calendar"></span></span>
          </div>
        </div>
        <div class="gs-filter-col">
          {{ form_label(form.fine) }}
          <div class="input-group date">
            {{ form_widget(form.fine, {attr: {widget: false}}) }}
            <span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-calendar"></span></span>
          </div>
        </div>
      </div>
      <div class="form-group">
        {{ form_label(form.oggetto) }}
        {{ form_widget(form.oggetto) }}
      </div>
      <div class="gs-filters-buttons">
        <button type="button" class="btn btn-default" id="circolare_gestione_reset" title="Resetta i filtri">Reset</button>
        {{ form_widget(form.submit) }}
      </div>
      {{ form_widget(form._token) }}
    </div>
  </form>
  {% set intestazione = [
    {contenuto: 'label.data'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.numero'|trans, classi: 'col-sm-1', scope: 'col'},
    {contenuto: 'label.sede'|trans, classi: 'col-sm-2', scope: 'col'},
    {contenuto: 'label.oggetto'|trans, classi: 'col-sm-6', scope: 'col'},
    {contenuto: 'label.action'|trans, classi: 'col-sm-2', scope: 'col'}
  ] %}
  {% set righe = [] %}
  {% for k, c in dati.pubblicate.lista %}
    {% set pulsanti = [] %}
    {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
      nome: 'eye', etichetta: 'Visualizza', titolo: 'Visualizza i dettagli della circolare',
      classi: 'gs-button-remote',
      attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote',
                  'data-href': path('circolari_dettagli_gestione', {circolare: c.id})}})]) %}
    {% if dati.azioni['publish-' ~ k].unpublish is defined %}
      {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
        nome: 'square-x', etichetta: 'Annulla pubblicazione',
        titolo: 'Rimuove la pubblicazione della circolare indicata', stile: 'warning',
        url: path('circolari_publish', {circolare: c.id, pubblica: 0})})]) %}
    {% endif %}
    {% set righe = righe|merge([{celle: [
      {contenuto: c.data|date('d/m/Y')},
      {contenuto: c.numero},
      {contenuto: '<small>' ~ c.sedi|map(s => s.nomeBreve|upper)|join(', ') ~ '</small>'},
      {contenuto: '<small>' ~ c.titolo ~ '</small>'},
      {contenuto: pulsanti}
    ]}]) %}
  {% endfor %}
  {{ include('include/tabella.html.twig', {intestazione: [intestazione], corpo: righe}) }}
  {{ include('include/paginate.html.twig', {maxPagine: dati.pubblicate.maxPagine, pagina: info.pagina, url: 'circolari_gestione'}) }}
  {{ include('include/modal-confirm.html.twig', {modal_confirm_msg: 'message.cancella_circolare'}) }}
  {{ include('include/modal-remote.html.twig') }}
</div>
{% endblock %}

{% block pagina_css %}
{{ parent() }}
<link href="{{ asset('vendor/bootstrap-datepicker/css/bootstrap-datepicker3.min.css') }}" rel="stylesheet">
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script src="{{ asset('vendor/bootstrap-datepicker/js/bootstrap-datepicker.min.js') }}"></script>
<script src="{{ asset('vendor/bootstrap-datepicker/locales/bootstrap-datepicker.it.min.js') }}"></script>
<script>
$(document).ready(function() {
  $('#{{ form.vars.id }} .input-group.date').datepicker({
    format: "dd/mm/yyyy",
    weekStart: 1,
    maxViewMode: 1,
    todayBtn: "linked",
    language: "it",
    autoclose: true,
    todayHighlight: true,
    zIndexOffset: 1200
    });
  $('#circolare_gestione_reset').click(function (e) {
    e.preventDefault();
    $('#circolare_filtro_inizio').val('');
    $('#circolare_filtro_fine').val('');
    $('#circolare_filtro_oggetto').val('');
    $('form[name="{{ form.vars.name }}"]').submit();
  });
  $('#gs-modal-confirm').on('show.bs.modal', function (event) {
    var href = $(event.relatedTarget).data('href');
    var csrf = $(event.relatedTarget).data('csrf');
    var text = $(event.relatedTarget).data('text');
    $(this).find('#gs-modal-confirm-form').attr('action', href);
    $(this).find('#gs-modal-confirm-csrf').val(csrf);
    $(this).find('#gs-modal-confirm-msg').text(text);
});
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href');
    $(this).find('#gs-modal-remote-content').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
});
</script>
{% endblock %}

{% extends 'ruolo_staff/index.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid gs-circolari-archivio">
  <h1 class="text-center gs-h2 gs-mt-2">{{ 'title.circolari_archivio'|trans }}</h1>
  <form name="{{ form.vars.name }}" method="{{ form.vars.method }}" action="{{ form.vars.action }}" class="gs-filters gs-mb-3">
    <div id="{{ form.vars.id }}">
      <div class="gs-filters-row">
        <div class="form-group gs-filter-col" title="{{ form.anno.vars.label|trans }}">
          <label class="control-label" for="circolare_filtro_anno">{{ form.anno.vars.label|trans }}</label>
          {{ form_widget(form.anno) }}
        </div>
        <div class="form-group gs-filter-col" title="{{ form.mese.vars.label|trans }}">
          <label class="control-label" for="circolare_filtro_mese">{{ form.mese.vars.label|trans }}</label>
          {{ form_widget(form.mese) }}
        </div>
      </div>
      <div class="form-group" title="{{ form.oggetto.vars.label|trans }}">
        <label class="control-label" for="circolare_filtro_oggetto">{{ form.oggetto.vars.label|trans }}</label>
        {{ form_widget(form.oggetto) }}
      </div>
      <div class="gs-filters-buttons">
        <button type="button" class="btn btn-default" id="circolare_archivio_reset" title="Resetta i filtri">Reset</button>
        {{ form_widget(form.submit) }}
      </div>
      {{ form_widget(form._token) }}
    </div>
  </form>
  {% if dati.lista|length > 0 %}
  {% set intestazione = [
    {contenuto: 'label.numero'|trans, classi: 'col-sm-2', scope: 'col'},
    {contenuto: 'label.data'|trans, classi: 'col-sm-2', scope: 'col'},
    {contenuto: 'label.oggetto'|trans, classi: 'col-sm-6', scope: 'col'},
    {contenuto: 'label.action'|trans, classi: 'col-sm-2', scope: 'col'}
  ] %}
  {% set righe = [] %}
  {% for c in dati.lista %}
    {% set pulsanti = [] %}
    {% set pulsanti = pulsanti|merge([include('include/bottone-azione.html.twig', {
      nome: 'eye', etichetta: 'Visualizza', titolo: 'Visualizza i dettagli della circolare',
      classi: 'gs-button-remote',
      attributi: {'data-toggle': 'modal', 'data-target': '#gs-modal-remote',
                  'data-href': path('circolari_dettagli_gestione', {circolare: c.circolare.id})}})]) %}
    {% set righe = righe|merge([{celle: [
      {contenuto: c.circolare.numero},
      {contenuto: c.circolare.data|date('d/m/Y')},
      {contenuto: '<small>' ~ c.circolare.titolo ~ '</small>'},
      {contenuto: pulsanti}
    ]}]) %}
  {% endfor %}
  {{ include('include/tabella.html.twig', {
    intestazione: [intestazione], corpo: righe,
    classi: 'table table-bordered table-hover table-striped gs-mb-4'
  }) }}
  {% else %}
  <div class="alert alert-info" role="alert">
    <strong class="gs-big">Nessuna circolare presente</strong>
  </div>
  {% endif %}
  {{ include('include/paginate.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'circolari_archivio'}) }}
  {{ include('include/modal-remote.html.twig') }}
  {{ include('include/modal-waiting.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
{{ parent() }}
<script>
$(document).ready(function() {
  $('#circolari_anno').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#circolari_mese').change(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#circolare_archivio_reset').click(function (e) {
    e.preventDefault();
    $('#circolare_filtro_anno').val('');
    $('#circolare_filtro_mese').val('');
    $('#circolare_filtro_oggetto').val('');
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#circolari_submit').click(function (e) {
    $('form[name="{{ form.vars.name }}"]').submit();
    $('#gs-modal-waiting').modal('show');
  });
  $('#gs-modal-remote').on('show.bs.modal', function (event) {
    var url = $(event.relatedTarget).data('href');
    $(this).find('#gs-modal-remote-content').load(url);
  });
  $(".gs-button-remote").click(function(e) {
    e.preventDefault();
    $('#gs-modal-remote-content').html('<div class="modal-content"><div class="modal-header"><h3 class="modal-title">Attendere prego...</h3></div><div class="modal-body"><div class="progress"><div class="progress-bar progress-bar-info progress-bar-striped active" style="width: 100%"></div></div></div></div>');
  });
});
</script>
{% endblock %}

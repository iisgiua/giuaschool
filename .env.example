# .env.example
# =============================================================================
# giua@school - modello e documentazione della configurazione
# =============================================================================
# Questo file è versionato e non contiene credenziali. Viene caricato come
# base da config/bootstrap.php; i valori specifici della macchina vanno in
# .env.local (non versionato), che ha la precedenza.
#
# Sviluppo locale:
#   cp .env.example .env.local
#   impostare APP_SECRET e DATABASE_URL in .env.local
#
# Test:
#   .env.test (versionato) viene caricato quando APP_ENV=test
#
# Produzione:
#   l'installer genera .env.local con APP_ENV=prod, un APP_SECRET casuale,
#   DATABASE_URL e LOG_LEVEL=warning. In Docker lo fa entrypoint.sh.
#   Non inserire segreti in questo file.
# =============================================================================

### definisce l'ambiente correntemente utilizzato (dev, prod, test)
APP_ENV='dev'

### codice segreto univoco usato nella gestione della sicurezza, chiave dei dati cifrati
### generato dall'installazione in .env.local: non inserire qui un valore reale
APP_SECRET=''

### parametri di connessione al database
### produzione: mysql://utente:password@host:3306/giuaschool
### impostati dall'installazione in .env.local
DATABASE_URL=''

### parametri di connessione al server email
### produzione: smtp://utente:password@smtp.example.org:587
MAILER_DSN='php://default'

### parametri di configurazione per l'invio dei messaggi
MESSENGER_TRANSPORT_DSN='doctrine://default'

### autenticazione tramite Google Workspace
GOOGLE_API_KEY=''
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_AUTH_CONFIG=''
OAUTH_GOOGLE_CLIENT_ID=''
OAUTH_GOOGLE_CLIENT_SECRET=''
OAUTH_GOOGLE_CLIENT_HD=''

### autenticazione SPID/CIE tramite gateway MIM
MIMSPID_CLIENT_ID=''
MIMSPID_CLIENT_SECRET=''

### imposta il livello del log del sistema (warning in produzione, debug in sviluppo)
LOG_LEVEL='debug'

# .env
# Modello della configurazione dell'ambiente: file versionato, non deve contenere credenziali.
# I valori specifici della macchina sono in .env.local, non versionato - vedi docs/ARCHITETTURA.md

### definisce l'ambiente correntemente utilizzato
APP_ENV='dev'

### codice segreto univoco usato nella gestione della sicurezza, chiave dei dati cifrati
### generato dall'installazione in .env.local: non inserire qui un valore reale
APP_SECRET=''

### parametri di connessione al database
### impostati dall'installazione in .env.local
DATABASE_URL=''

### parametri di connessione al server email
MAILER_DSN='php://default'

### parametri di configurazione per l'invio dei messaggi
MESSENGER_TRANSPORT_DSN='doctrine://default'

### autenticazione tramite Google Workspace
GOOGLE_API_KEY=''
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_AUTH_CONFIG=''
OAUTH_GOOGLE_CLIENT_ID=''
OAUTH_GOOGLE_CLIENT_SECRET=''
OAUTH_GOOGLE_CLIENT_HD=''

### autenticazione SPID/CIE tramite gateway MIM
MIMSPID_CLIENT_ID=''
MIMSPID_CLIENT_SECRET=''

### imposta il livello del log del sistema in produzione
LOG_LEVEL='debug'
